@{
    ViewData["Title"] = "Shop";
    ViewData["ActiveNav"] = "Shop";
}

<!-- MAIN HERO -->
<section class="position-relative overflow-hidden bg-surface-low d-flex align-items-center" style="height: 90vh; min-height: 700px; margin-top: -100px;">
    <!-- Background Elements -->
    <div class="position-absolute top-50 start-50 translate-middle w-100 h-100" style="background: radial-gradient(circle at 70% 30%, rgba(255, 90, 0, 0.15) 0%, transparent 50%); z-index: 0;"></div>
    
    <div class="container-fluid max-width-1440 position-relative z-1 px-4">
        <div class="row align-items-center">
            <div class="col-lg-7 order-2 order-lg-1">
                <div class="hero-content p-4 p-md-0">
                    <p class="text-primary fw-bold text-uppercase tracking-widest mb-3" style="font-family: 'Space Mono', monospace; font-size: 0.8rem;">[ ENGINEERED FOR MOTION ]</p>
                    <h1 class="display-1 fw-bold mb-4 tracking-tighter" style="line-height: 0.85; font-size: calc(3rem + 6vw);">
                        KINETIC<br><span class="text-outline" style="-webkit-text-stroke: 2px var(--kinetic-on-surface); color: transparent;">PRECISION</span>
                    </h1>
                    <div class="glass-card p-4 rounded-4 mt-5 border border-white shadow-sm" style="max-width: 500px; background: rgba(255, 255, 255, 0.4); backdrop-filter: blur(10px);">
                        <p class="fs-6 text-dark mb-4" style="line-height: 1.6;">Experience next-level energy return with our proprietary foam technology. The new Kinetic Aero strikes the perfect balance of weightless feel and aggressive grip.</p>
                        <div class="d-flex gap-3">
                            <button class="btn btn-kinetic-primary">SHOP COLLECTION</button>
                            <button class="btn btn-kinetic-secondary">TECH SPECS</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 order-1 order-lg-2 position-relative">
                <div class="hero-image-container py-5">
                    <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuC-Z59r9b0vyyQJzgaLYRB6Ib8kMRiAg7yPUznIdRxusg0xsX3Rnp4GY5IUj5WL-qBAt1Y8IifoRj7RGC_94TQXfsJsI-fIX-QMZOBJHfZR_Nj42kcwWcV2ULKSN28dpD3twGVToH35WexsqQ8enob5avvYPYmoHt-Ckrg0wWg29eThLjkD1BqM9fFWPUpl-LoRJ2poo0pS4jPOB3QrGpNGpvYzE97PJowc1YAV4Wo0ntO-fF2U43RQQ2jUYPQCACoZy9T-EGNGPjWU" 
                         class="img-fluid floating-img" 
                         style="filter: drop-shadow(0 50px 80px rgba(0,0,0,0.25)); transform: rotate(-15deg) scale(1.2); z-index: 2; position: relative;" alt="Kinetic Aero Hero">
                    <!-- Tech Specs Floating Badge -->
                    <div class="position-absolute bottom-0 start-0 glass-card p-3 rounded-4 border border-white shadow-sm d-none d-md-block" style="background: rgba(255, 255, 255, 0.6); backdrop-filter: blur(10px); z-index: 3;">
                        <span class="d-block text-primary fw-bold small" style="font-family: 'Space Mono', monospace;">+45% ENERGY RETURN</span>
                        <span class="d-block text-dark small">ULTRA-LIGHT FOAM</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .text-outline {
        transition: all 0.5s ease;
    }
    .floating-img {
        animation: float 6s ease-in-out infinite;
    }
    @@keyframes float {
        0%, 100% { transform: translateY(0) rotate(-15deg) scale(1.2); }
        50% { transform: translateY(-30px) rotate(-12deg) scale(1.2); }
    }
    .hero-content {
        animation: fadeIn 1s ease-out;
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateX(-30px); }
        to { opacity: 1; transform: translateX(0); }
    }
</style>

<!-- PRODUCT SECTION -->
<div class="container-fluid max-width-1440 py-5 px-4 mt-5">
    <div class="row g-5">
        <!-- Sidebar Filter -->
        <div class="col-12 col-lg-3 d-none d-lg-block">
            <div class="sticky-top" style="top: 120px;">
                <div class="d-flex justify-content-between align-items-center mb-5">
                    <h2 class="font-headline fs-5 mb-0">Bộ lọc</h2>
                    <button class="btn btn-link text-secondary text-decoration-none small p-0">Xóa tất cả</button>
                </div>

                <!-- Categorie -->
                <div class="mb-5">
                    <h3 class="filter-section-title">DANH MỤC</h3>
                    <div class="d-flex flex-column gap-3">
                        <div class="form-check custom-check">
                            <input class="form-check-input shadow-none" type="checkbox" id="cat1" checked>
                            <label class="form-check-label text-dark fw-bold" for="cat1">Running (245)</label>
                        </div>
                        <div class="form-check custom-check">
                            <input class="form-check-input shadow-none" type="checkbox" id="cat2">
                            <label class="form-check-label text-secondary" for="cat2">Training (128)</label>
                        </div>
                        <div class="form-check custom-check">
                            <input class="form-check-input shadow-none" type="checkbox" id="cat3">
                            <label class="form-check-label text-secondary" for="cat3">Trail (64)</label>
                        </div>
                        <div class="form-check custom-check">
                            <input class="form-check-input shadow-none" type="checkbox" id="cat4">
                            <label class="form-check-label text-secondary" for="cat4">Lifestyle (312)</label>
                        </div>
                    </div>
                </div>

                <!-- Size -->
                <div class="mb-5">
                    <h3 class="filter-section-title">KÍCH THƯỚC (US)</h3>
                    <div class="row g-2">
                        <div class="col-4"><button class="btn btn-outline-secondary w-100 py-2 small fw-bold">7</button></div>
                        <div class="col-4"><button class="btn btn-outline-secondary w-100 py-2 small fw-bold">7.5</button></div>
                        <div class="col-4"><button class="btn btn-outline-secondary w-100 py-2 small fw-bold active">8</button></div>
                        <div class="col-4"><button class="btn btn-outline-secondary w-100 py-2 small fw-bold">8.5</button></div>
                        <div class="col-4"><button class="btn btn-outline-secondary w-100 py-2 small fw-bold">9</button></div>
                        <div class="col-4"><button class="btn btn-outline-secondary w-100 py-2 small fw-bold">9.5</button></div>
                    </div>
                </div>

                <!-- Colors -->
                <div class="mb-5">
                    <h3 class="filter-section-title">MÀU SẮC</h3>
                    <div class="d-flex flex-wrap gap-3">
                        <div class="color-swatch active"><div class="color-swatch-inner" style="background: #000;"></div></div>
                        <div class="color-swatch"><div class="color-swatch-inner" style="background: #FF5A00;"></div></div>
                        <div class="color-swatch"><div class="color-swatch-inner" style="background: #fff; border: 1px solid #e2e2e5;"></div></div>
                        <div class="color-swatch"><div class="color-swatch-inner" style="background: #3b82f6;"></div></div>
                        <div class="color-swatch"><div class="color-swatch-inner" style="background: #10b981;"></div></div>
                    </div>
                </div>

                <!-- Price Range Slider (Placeholder for UI) -->
                <div class="mb-5">
                    <h3 class="filter-section-title">GIÁ CẢ</h3>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="small text-secondary">0đ</span>
                        <span class="small text-secondary">5.000.000đ+</span>
                    </div>
                    <input type="range" class="form-range" min="0" max="5000000" step="100000">
                </div>
            </div>
        </div>
        
        <!-- Grid -->
        <div class="col-12 col-lg-9">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-4">
                <div>
                    <h2 class="font-headline fs-4 mb-1">Tất cả sản phẩm</h2>
                    <p class="text-secondary small mb-0">Hiển thị 1 - 24 của 1,248 sản phẩm</p>
                </div>
                <div class="d-flex gap-3 align-items-center">
                    <span class="text-secondary small d-none d-md-block">Sắp xếp theo:</span>
                    <select class="form-select w-auto border-0 bg-white shadow-sm rounded-pill px-4 py-2 small">
                        <option>Nổi bật nhất</option>
                        <option>Mới nhất</option>
                        <option>Giá: Thấp đến Cao</option>
                        <option>Giá: Cao đến Thấp</option>
                    </select>
                </div>
            </div>

            <div class="row g-5">
                <!-- Product Items (Simulated for many products) -->
                <!-- Duplicate this card structure logic... -->
                @for(int i = 0; i < 6; i++) {
                    <div class="col-12 col-md-6 mb-4">
                        <a asp-area="User" asp-controller="Product" asp-action="Detail" asp-route-id="1" class="text-decoration-none">
                            <div class="kinetic-card h-100">
                                <span class="badge bg-white text-dark shadow-sm position-absolute rounded-pill py-2 px-3 tracking-widest text-uppercase" style="top:1.5rem; left:1.5rem; z-index:10; font-size: 0.6rem; font-family: 'Space Mono';">New Arrival</span>
                                <div class="kinetic-card-img-container">
                                    <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuC-Z59r9b0vyyQJzgaLYRB6Ib8kMRiAg7yPUznIdRxusg0xsX3Rnp4GY5IUj5WL-qBAt1Y8IifoRj7RGC_94TQXfsJsI-fIX-QMZOBJHfZR_Nj42kcwWcV2ULKSN28dpD3twGVToH35WexsqQ8enob5avvYPYmoHt-Ckrg0wWg29eThLjkD1BqM9fFWPUpl-LoRJ2poo0pS4jPOB3QrGpNGpvYzE97PJowc1YAV4Wo0ntO-fF2U43RQQ2jUYPQCACoZy9T-EGNGPjWU" alt="Product Image">
                                    <div class="quick-add-container">
                                        <button class="quick-add-btn"><span class="material-symbols-outlined">shopping_cart</span></button>
                                    </div>
                                </div>
                                <div class="p-4 d-flex justify-content-between align-items-start">
                                    <div>
                                        <h4 class="font-headline fs-6 fw-bold mb-1">Kinetic Quantum V2</h4>
                                        <p class="text-secondary small mb-0">Running Shoes / Black / Red</p>
                                    </div>
                                    <div class="text-end">
                                        <span class="text-dark fw-bold fs-5">2.450.000đ</span>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>

            <!-- PAGINATION -->
            <nav aria-label="Page navigation" class="mt-5 pt-5">
                <ul class="pagination kinetic-pagination justify-content-center">
                    <li class="page-item disabled"><a class="page-link" href="#"><span class="material-symbols-outlined fs-5">chevron_left</span></a></li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                    <li class="page-item"><span class="page-link">...</span></li>
                    <li class="page-item"><a class="page-link" href="#">52</a></li>
                    <li class="page-item"><a class="page-link" href="#"><span class="material-symbols-outlined fs-5">chevron_right</span></a></li>
                </ul>
            </nav>
        </div>
    </div>
</div>
