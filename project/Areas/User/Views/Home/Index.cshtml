    @model project.Models.ProductHomeViewModel
@{
    ViewData["Title"] = Localizer["ShopTitle"];
    ViewData["ActiveNav"] = "Shop";
    var availableSizes = ViewBag.AvailableSizes as List<string> ?? new List<string>();
    var availableColors = ViewBag.AvailableColors as List<string> ?? new List<string>();
}

<!-- MAIN HERO -->
<section class="position-relative overflow-hidden bg-surface-low d-flex align-items-center" style="height: 90vh; min-height: 700px; margin-top: -100px;">
    <!-- Background Elements -->
    <div class="position-absolute top-50 start-50 translate-middle w-100 h-100" style="background: radial-gradient(circle at 70% 30%, rgba(255, 90, 0, 0.15) 0%, transparent 50%); z-index: 0;"></div>
    
    <div class="container-fluid max-width-1440 position-relative z-1 px-4">
        <div class="row align-items-center">
            <div class="col-lg-7 order-2 order-lg-1">
                <div class="hero-content p-4 p-md-0">
                    <h1 class="display-1 fw-bold mb-4 tracking-tighter" style="line-height: 0.85; font-size: calc(3rem + 6vw);">
                        KINETIC<br><span class="text-outline" style="-webkit-text-stroke: 2px var(--kinetic-on-surface); color: transparent; font-family: sans-serif;">PRECISION</span>
                    </h1>
                    <div class="glass-card p-4 rounded-4 mt-5 border border-white shadow-sm" style="max-width: 500px; background: rgba(255, 255, 255, 0.4); backdrop-filter: blur(10px);">
                        <p class="fs-6 text-dark mb-4" style="line-height: 1.6;">@Localizer["HeroDesc"]</p>
                        <div class="d-flex gap-3">
                            <a href="#product-section" class="btn btn-kinetic-primary">@Localizer["ShopCollection"]</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 order-1 order-lg-2 position-relative">
                <div class="hero-image-container py-5">
                    <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuC-Z59r9b0vyyQJzgaLYRB6Ib8kMRiAg7yPUznIdRxusg0xsX3Rnp4GY5IUj5WL-qBAt1Y8IifoRj7RGC_94TQXfsJsI-fIX-QMZOBJHfZR_Nj42kcwWcV2ULKSN28dpD3twGVToH35WexsqQ8enob5avvYPYmoHt-Ckrg0wWg29eThLjkD1BqM9fFWPUpl-LoRJ2poo0pS4jPOB3QrGpNGpvYzE97PJowc1YAV4Wo0ntO-fF2U43RQQ2jUYPQCACoZy9T-EGNGPjWU" 
                         class="img-fluid floating-img" 
                         style="filter: drop-shadow(0 50px 80px rgba(0,0,0,0.25)); transform: rotate(-15deg) scale(1.2); z-index: 2; position: relative; margin-left:80px;" alt="Kinetic Aero Hero">
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .text-outline {
        transition: all 0.5s ease;
    }
    .floating-img {
        animation: float 6s ease-in-out infinite;
    }
    @@keyframes float {
        0%, 100% { transform: translateY(0) rotate(-15deg) scale(1.2); }
        50% { transform: translateY(-30px) rotate(-12deg) scale(1.2); }
    }
    .hero-content {
        animation: fadeIn 1s ease-out;
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateX(-30px); }
        to { opacity: 1; transform: translateX(0); }
    }
    .color-swatch-input {
        display: none;
    }
    .color-swatch-label {
        cursor: pointer;
    }
    .color-swatch.active {
        border: 2px solid var(--kinetic-primary);
        padding: 2px;
    }
</style>

<!-- PRODUCT SECTION -->
<div id="product-section" class="container-fluid max-width-1440 py-5 px-4 mt-5">
    <!-- SEARCH & FILTER BAR -->
    <div class="bg-white rounded-4 shadow-sm border border-secondary-subtle p-3 mb-5">
        <form id="filter-form-top" method="get" asp-area="User" asp-controller="Home" asp-action="Index">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-md-4">
                    <select name="categories" class="form-select bg-light border-0 rounded-pill px-4 shadow-none small filter-input">
                        <option value="">@Localizer["AllCategories"]</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.Id" selected="@(Model.SelectedCategories.Contains(cat.Id.ToString()))">@cat.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <div class="input-group bg-light rounded-pill px-3 py-1 border-0">
                        <span class="input-group-text bg-transparent border-0 text-secondary"><i class="fa-solid fa-magnifying-glass fs-6"></i></span>
                        <input type="text" name="search" value="@Model.SearchQuery" class="form-control bg-transparent border-0 shadow-none small" placeholder="@Localizer["SearchPlaceholder"]">
                    </div>
                </div>
                <div class="col-12 col-md-2">
                    <select name="sortBy" class="form-select bg-light border-0 rounded-pill px-4 shadow-none small filter-input">
                        <option value="featured" selected="@(Model.SortBy == "featured")">@Localizer["Featured"]</option>
                        <option value="newest" selected="@(Model.SortBy == "newest")">@Localizer["Newest"]</option>
                        <option value="price_asc" selected="@(Model.SortBy == "price_asc")">@Localizer["PriceLowToHigh"]</option>
                        <option value="price_desc" selected="@(Model.SortBy == "price_desc")">@Localizer["PriceHighToLow"]</option>
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <button type="submit" class="btn btn-primary bg-primary border-0 rounded-pill w-100 fw-bold small">@Localizer["Filter"]</button>
                </div>
            </div>
        </form>
    </div>

    <form id="filter-form" method="get" asp-area="User" asp-controller="Home" asp-action="Index">
        <input type="hidden" name="search" value="@Model.SearchQuery" />
        <div class="row g-5">
            <!-- Sidebar Filter -->
            <div class="col-12 col-lg-3 d-none d-lg-block">
                <div class="sticky-top" style="top: 120px;">
                    <div class="d-flex justify-content-between align-items-center mb-5">
                        <h2 class="font-headline fs-5 mb-0">@Localizer["Filters"]</h2>
                        <a href="@Url.Action("Index", "Home", new { area = "User" })" class="btn btn-link text-secondary text-decoration-none small p-0">@Localizer["ClearAll"]</a>
                    </div>

                    <!-- Categories -->
                    <div class="mb-5">
                        <h3 class="filter-section-title">@Localizer["Categories"]</h3>
                        <div class="d-flex flex-column gap-3">
                            @foreach (var category in Model.Categories)
                            {
                                <div class="form-check custom-check">
                                    <input class="form-check-input shadow-none filter-input" type="checkbox" name="categories" value="@category.Id" id="cat-@category.Id" @(Model.SelectedCategories.Contains(category.Id.ToString()) ? "checked" : "")>
                                    <label class="form-check-label @(Model.SelectedCategories.Contains(category.Id.ToString()) ? "text-dark fw-bold" : "text-secondary")" for="cat-@category.Id">@category.Name</label>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Size -->
                    <div class="mb-5">
                        <h3 class="filter-section-title">@Localizer["Sizes"]</h3>
                        <div class="row g-2">
                            @foreach (var size in availableSizes)
                            {
                                <div class="col-4">
                                    <input type="checkbox" name="sizes" value="@size" id="size-@size" class="btn-check filter-input" @(Model.SelectedSizes.Contains(size) ? "checked" : "")>
                                    <label class="btn btn-outline-secondary w-100 py-2 small fw-bold" for="size-@size">@size</label>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Colors -->
                    <div class="mb-5">
                        <h3 class="filter-section-title">@Localizer["Colors"]</h3>
                        <div class="d-flex flex-wrap gap-3">
                            @foreach (var color in availableColors)
                            {
                                <div class="color-swatch-container">
                                    <input type="checkbox" name="colors" value="@color" id="color-@color" class="color-swatch-input filter-input" @(Model.SelectedColors.Contains(color) ? "checked" : "")>
                                    <label class="color-swatch @(Model.SelectedColors.Contains(color) ? "active" : "")" for="color-@color">
                                        <div class="color-swatch-inner" style="background: @color; border: 1px solid #e2e2e5;"></div>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Grid -->
            <div class="col-12 col-lg-9">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-4">
                    <div>
                        <h2 class="font-headline fs-4 mb-1">
                            @if (!string.IsNullOrEmpty(Model.SearchQuery))
                            {
                                @Localizer["ResultsFor", Model.SearchQuery]
                            }
                            else
                            {
                                @Localizer["AllProducts"]
                            }
                        </h2>
                        <p class="text-secondary small mb-0">@Localizer["DisplayingCount", Model.Products.Count, Model.TotalItems]</p>
                    </div>
                    <div class="d-flex gap-3 align-items-center d-lg-none">
                        <span class="text-secondary small">@Localizer["SortBy"]:</span>
                        <select name="sortBy" class="form-select w-auto border-0 bg-white shadow-sm rounded-pill px-4 py-2 small filter-input">
                            <option value="featured" selected="@(Model.SortBy == "featured")">@Localizer["Featured"]</option>
                            <option value="newest" selected="@(Model.SortBy == "newest")">@Localizer["Newest"]</option>
                            <option value="price_asc" selected="@(Model.SortBy == "price_asc")">@Localizer["PriceLowToHigh"]</option>
                            <option value="price_desc" selected="@(Model.SortBy == "price_desc")">@Localizer["PriceHighToLow"]</option>
                        </select>
                    </div>
                </div>

                <div class="row g-5">
                    @if (Model.Products.Count == 0)
                    {
                        <div class="col-12 text-center py-5">
                            <i class="fa-solid fa-magnifying-glass-minus fa-2xl text-secondary opacity-25 mb-4" style="font-size: 4rem;"></i>
                            <h3 class="text-secondary">@Localizer["NoProductsFound"]</h3>
                            <p class="text-secondary">@Localizer["TryChangingFilters"]</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var product in Model.Products)
                        {
                            var mainImage = product.ProductImages.FirstOrDefault(i => i.IsMain)?.ImageUrl 
                                           ?? product.ProductImages.FirstOrDefault()?.ImageUrl 
                                           ?? "https://via.placeholder.com/600x600?text=No+Image";
                            
                            <div class="col-12 col-md-6 mb-4">
                                <a asp-area="User" asp-controller="Product" asp-action="Detail" asp-route-id="@product.Id" class="text-decoration-none">
                                    <div class="kinetic-card h-100">
                                        @if (product.IsFeatured)
                                        {
                                            <span class="badge bg-white text-dark shadow-sm position-absolute rounded-pill py-2 px-3 tracking-widest text-uppercase" style="top:1.5rem; left:1.5rem; z-index:10; font-size: 0.6rem; font-family: 'Space Mono';">Featured</span>
                                        }
                                        else if ((DateTime.Now - product.CreatedAt).TotalDays < 30)
                                        {
                                            <span class="badge bg-white text-dark shadow-sm position-absolute rounded-pill py-2 px-3 tracking-widest text-uppercase" style="top:1.5rem; left:1.5rem; z-index:10; font-size: 0.6rem; font-family: 'Space Mono';">New Arrival</span>
                                        }
                                        
                                        <div class="kinetic-card-img-container">
                                            <img src="@mainImage" alt="@product.Name" loading="lazy">
                                        </div>
                                        <div class="p-4 d-flex justify-content-between align-items-start">
                                            <div>
                                                <h4 class="font-headline fs-6 fw-bold mb-1">@product.Name</h4>
                                                <p class="text-secondary small mb-0">@product.Category.Name / @string.Join(", ", product.ProductVariants.Select(v => v.Color).Distinct())</p>
                                            </div>
                                            <div class="text-end">
                                                @if (product.SalePrice.HasValue && product.SalePrice < product.BasePrice)
                                                {
                                                    <span class="text-danger fw-bold fs-5">@product.SalePrice.Value.ToString("N0")đ</span>
                                                    <br />
                                                    <small class="text-secondary text-decoration-line-through">@product.BasePrice.ToString("N0")đ</small>
                                                }
                                                else
                                                {
                                                    <span class="text-dark fw-bold fs-5">@product.BasePrice.ToString("N0")đ</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    }
                </div>

                <!-- PAGINATION -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Page navigation" class="mt-5 pt-5">
                        <ul class="pagination kinetic-pagination justify-content-center">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <button type="submit" name="page" value="@(Model.CurrentPage - 1)" class="page-link border-0 bg-transparent">
                                    <i class="fa-solid fa-chevron-left fs-6"></i>
                                </button>
                            </li>
                            
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                    <button type="submit" name="page" value="@i" class="page-link border-0 bg-transparent">@i</button>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <button type="submit" name="page" value="@(Model.CurrentPage + 1)" class="page-link border-0 bg-transparent">
                                    <i class="fa-solid fa-chevron-right fs-6"></i>
                                </button>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.filter-input').forEach(input => {
            input.addEventListener('change', () => {
                const topForm = document.getElementById('filter-form-top');
                const sidebarForm = document.getElementById('filter-form');
                
                // If top filter changed, submit top form, otherwise sidebar
                if (input.closest('#filter-form-top')) {
                    topForm.submit();
                } else {
                    sidebarForm.submit();
                }
            });
        });
    </script>
}
