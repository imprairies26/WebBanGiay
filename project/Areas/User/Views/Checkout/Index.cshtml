@using System.Linq
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model project.Models.Cart
@{
    ViewData["Title"] = Localizer["CheckoutTitle"];
    Layout = "~/Views/Shared/_Layout.cshtml";
    var totalAmount = Model?.CartItems.Sum(item => (item.ProductVariant.Product.SalePrice ?? item.ProductVariant.Product.BasePrice) * item.Quantity) ?? 0;
}

<div class="container-fluid max-width-1440 py-5 px-4 mt-5">
    <form asp-action="PlaceOrder" method="post" id="checkout-form">
        @Html.AntiForgeryToken()
        <div class="row g-5">
            <!-- Left: Checkout Form -->
            <div class="col-lg-8">
                <div class="glass-card p-4 p-md-5 rounded-4 border border-white shadow-sm mb-4">
                    <h2 class="font-headline fs-4 fw-bold mb-4">@Localizer["ShippingInfoHeader"]</h2>
                    
                    <div class="row g-4">
                        <div class="col-12">
                            <label class="form-label small text-uppercase tracking-wider fw-bold text-secondary">@Localizer["FullName"]</label>
                            <input type="text" name="fullName" class="form-control bg-light border-0 py-3 px-4 rounded-3 shadow-none" placeholder="@Localizer["FullNamePlaceholder"]" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase tracking-wider fw-bold text-secondary">@Localizer["PhoneNumber"]</label>
                            <input type="tel" name="phoneNumber" class="form-control bg-light border-0 py-3 px-4 rounded-3 shadow-none" placeholder="0xxx xxx xxx" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase tracking-wider fw-bold text-secondary">@Localizer["EmailOptional"]</label>
                            <input type="email" name="email" class="form-control bg-light border-0 py-3 px-4 rounded-3 shadow-none" placeholder="name@example.com">
                        </div>
                        <div class="col-12">
                            <label class="form-label small text-uppercase tracking-wider fw-bold text-secondary">@Localizer["ShippingAddress"]</label>
                            <textarea name="shippingAddress" class="form-control bg-light border-0 py-3 px-4 rounded-3 shadow-none" rows="3" placeholder="@Localizer["ShippingAddressPlaceholder"]" required></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small text-uppercase tracking-wider fw-bold text-secondary">@Localizer["OrderNote"]</label>
                            <textarea name="customerNote" class="form-control bg-light border-0 py-3 px-4 rounded-3 shadow-none" rows="2" placeholder="@Localizer["OrderNotePlaceholder"]"></textarea>
                        </div>
                    </div>
                </div>

                <div class="glass-card p-4 p-md-5 rounded-4 border border-white shadow-sm">
                    <h2 class="font-headline fs-4 fw-bold mb-4">@Localizer["PaymentMethodHeader"]</h2>
                    
                    <div class="d-flex flex-column gap-3">
                        <div class="form-check custom-option-check p-0">
                            <input class="btn-check" type="radio" name="paymentMethod" id="pay-cod" value="COD" checked>
                            <label class="btn btn-outline-light border text-start w-100 p-4 rounded-4 d-flex align-items-center gap-3" for="pay-cod">
                                <div class="icon-box bg-primary text-white rounded-3 d-flex align-items-center justify-content-center" style="width:48px; height:48px;">
                                    <i class="fa-solid fa-truck-fast fs-4"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <span class="d-block fw-bold">@Localizer["PaymentCOD"]</span>
                                    <span class="small text-secondary">@Localizer["PaymentCODDesc"]</span>
                                </div>
                                <i class="fa-solid fa-circle-check text-primary check-icon"></i>
                            </label>
                        </div>

                        <div class="form-check custom-option-check p-0">
                            <input class="btn-check" type="radio" name="paymentMethod" id="pay-bank" value="BankTransfer">
                            <label class="btn btn-outline-light border text-start w-100 p-4 rounded-4 d-flex align-items-center gap-3" for="pay-bank">
                                <div class="icon-box bg-dark text-white rounded-3 d-flex align-items-center justify-content-center" style="width:48px; height:48px;">
                                    <i class="fa-solid fa-building-columns fs-4"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <span class="d-block fw-bold">@Localizer["PaymentBank"]</span>
                                    <span class="small text-secondary">@Localizer["PaymentBankDesc"]</span>
                                </div>
                                <i class="fa-solid fa-circle-check text-primary check-icon"></i>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Order Summary -->
            <div class="col-lg-4">
                <div class="sticky-top" style="top: 120px;">
                    <div class="glass-card p-4 rounded-4 border border-white shadow-sm mb-4">
                        <h2 class="font-headline fs-4 fw-bold mb-4">@Localizer["YourOrderHeader"]</h2>
                        
                        <div class="order-items-list mb-4 overflow-auto" style="max-height: 400px;">
                            @if (Model != null) {
                                @foreach (var item in Model.CartItems)
                                {
                                    var product = item.ProductVariant.Product;
                                    var mainImage = product.ProductImages.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? product.ProductImages.FirstOrDefault()?.ImageUrl ?? "https://via.placeholder.com/150";
                                    var price = product.SalePrice ?? product.BasePrice;

                                    <div class="d-flex align-items-center gap-3 mb-3">
                                        <div class="position-relative">
                                            <img src="@mainImage" class="rounded-3 border" style="width:64px; height:64px; object-fit:cover;">
                                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-dark" style="font-size:0.6rem">@item.Quantity</span>
                                        </div>
                                        <div class="flex-grow-1 min-width-0">
                                            <h6 class="small fw-bold mb-0 text-truncate">@product.Name</h6>
                                            <p class="text-secondary mb-0" style="font-size:0.75rem">Size: @item.ProductVariant.Size / @item.ProductVariant.Color</p>
                                        </div>
                                        <span class="small fw-bold">@((price * item.Quantity).ToString("N0"))đ</span>
                                    </div>
                                }
                            }
                        </div>

                        <div class="promo-section mb-4 pt-4 border-top border-light">
                            <label class="form-label small text-uppercase tracking-wider fw-bold text-secondary">@Localizer["PromoCode"]</label>
                            <div class="d-flex gap-2">
                                <input type="text" id="promo-code-input" name="promoCode" class="form-control bg-light border-0 py-2 px-3 rounded-pill shadow-none" placeholder="@Localizer["PromoPlaceholder"]">       
                                <button type="button" onclick="applyPromo()" class="btn btn-dark rounded-pill px-4 py-2 small">@Localizer["ApplyBtn"]</button>
                            </div>
                            <div id="promo-message" class="small mt-2"></div>
                        </div>

                        <div class="summary-details d-flex flex-column gap-2 mb-4 pt-4 border-top border-light">
                            <div class="d-flex justify-content-between small">
                                <span class="text-secondary">@Localizer["Subtotal"]</span>
                                <span class="fw-bold">@totalAmount.ToString("N0")đ</span>
                            </div>
                            <div class="d-flex justify-content-between small">
                                <span class="text-secondary">@Localizer["ShippingFee"]</span>
                                <span class="text-success fw-bold">@Localizer["Free"]</span>
                            </div>
                            <div class="d-flex justify-content-between small text-danger" id="discount-row" style="display:none !important">
                                <span>@Localizer["Discount"]</span>
                                <span id="discount-amount">-0đ</span>
                            </div>
                            <div class="d-flex justify-content-between fs-5 fw-bold mt-2 pt-2 border-top border-light">
                                <span>@Localizer["Total"]</span>
                                <span class="text-primary" id="final-amount">@totalAmount.ToString("N0")đ</span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-kinetic-primary w-100 py-3 shadow-sm fs-5 fw-bold">@Localizer["PlaceOrderBtn"]</button>
                        
                        <div class="mt-4 text-center">
                            <p class="text-secondary small">@Localizer["TermsAgreement"]</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        async function applyPromo() {
            console.log("Applying promo...");
            const codeInput = document.getElementById('promo-code-input');
            const messageEl = document.getElementById('promo-message');
            const discountRow = document.getElementById('discount-row');
            const discountAmountEl = document.getElementById('discount-amount');
            const finalAmountEl = document.getElementById('final-amount');
            
            const code = codeInput.value.trim();
            const total = parseFloat('@totalAmount');
            
            if (!code) {
                messageEl.className = 'small mt-2 text-danger';
                messageEl.innerText = 'Vui lòng nhập mã giảm giá';
                return;
            }

            try {
                const formData = new URLSearchParams();
                formData.append('code', code);
                formData.append('currentTotal', total);
                
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : "";

                console.log("Fetching validation for:", code);
                const response = await fetch('@Url.Action("ValidatePromo", "Checkout", new { area = "User" })', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token,
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: formData
                });
                
                const data = await response.json();
                console.log("Server response:", data);
                
                const formatter = new Intl.NumberFormat('vi-VN');

                if (data.success) {
                    messageEl.className = 'small mt-2 text-success';
                    messageEl.innerText = 'Áp dụng mã thành công!';
                    
                    discountRow.style.display = 'flex';
                    discountRow.style.setProperty('display', 'flex', 'important');
                    
                    discountAmountEl.innerText = '-' + formatter.format(data.discount) + 'đ';
                    finalAmountEl.innerText = formatter.format(data.finalTotal) + 'đ';
                } else {
                    messageEl.className = 'small mt-2 text-danger';
                    messageEl.innerText = data.message;
                    
                    discountRow.style.display = 'none';
                    discountRow.style.setProperty('display', 'none', 'important');
                    finalAmountEl.innerText = formatter.format(total) + 'đ';
                }
            } catch (e) {
                console.error("Error applying promo:", e);
                messageEl.className = 'small mt-2 text-danger';
                messageEl.innerText = 'Đã có lỗi xảy ra khi áp dụng mã.';
            }
        }
    </script>
}
