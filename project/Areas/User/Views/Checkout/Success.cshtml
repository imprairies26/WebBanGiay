@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model project.Models.Order
@{
    ViewData["Title"] = Localizer["SuccessTitle"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <div class="mb-4">
                <i class="fa-solid fa-circle-check text-success" style="font-size: 5rem;"></i>
            </div>
            
            <h2 class="fw-bold mb-4">@Localizer["ThankYouHeader"]</h2>
            <p class="text-secondary fs-5 mb-4">@Localizer["OrderReceivedMsg"]</p>
            
            <div class="glass-card p-4 rounded-4 border border-white shadow-sm mb-5 bg-light">
                <span class="text-secondary small d-block">@Localizer["OrderNoLabel"]</span>
                <h4 class="fw-bold text-primary mb-0">#@Model.Id</h4>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                <a asp-area="User" asp-controller="Home" asp-action="Index" class="btn btn-dark rounded-pill px-5 py-3">@Localizer["ContinueShoppingBtn"]</a>
                <a asp-area="User" asp-controller="Profile" asp-action="Index" class="btn btn-kinetic-secondary px-5 py-3">@Localizer["ViewOrderBtn"]</a>
            </div>
        </div>
    </div>
    <div class="text-center mt-5">
        <p class="text-secondary small">@Localizer["SupportText"]</p>
    </div>
</div>
