@{
    ViewData["Title"] = "Authentication";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="container" style="padding-top: 0 !important;">
    <div class="row min-vh-100 g-0">
        <!-- Image Side (Hidden on Mobile) -->
        <div class="col-lg-6 d-none d-lg-flex bg-surface-low p-5 align-items-center justify-content-center position-relative overflow-hidden">
            <h1 class="position-absolute align-self-start font-headline fw-bold fst-italic text-dark fs-1 w-100" style="top: 2rem; left: 2rem; z-index: 10;">KINETIC</h1>
            <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuA05vTjmRyjGZ6OHL3fXvxpfoKiex8GaFKWtLQPU7uQ520aLuPSaDSGIYeX2lfbw2lchHOrEjTdc51_WVOg6goTRpTc4O-UsoSsMR4xPIxWjgkJZOM45FA0WLdhJeEGb4cNQUPo5xU3rEaV6VW1F05LNL97L7lV0OakhxrSIgRubYtv46U5szWb_P6BOde6JY5B0mkklbi-usWAvU8nTDAK9I4yviX5QVe7ldv3-2wYsm8-lVahjNzMLd-T3dDGb_RedCa3qT4CAZBJ" 
                 alt="Kinetic Shoe" 
                 style="mix-blend-mode: multiply; max-width: 80%; transform: rotate(-15deg); filter: drop-shadow(0 40px 40px rgba(0,0,0,0.1));">
        </div>
        
        <!-- Form Side -->
        <div class="col-12 col-lg-6 d-flex align-items-center justify-content-center bg-surface-lowest">
            <div class="w-100 p-4 p-md-5" style="max-width: 500px;">
                <div class="d-lg-none mb-5 text-center">
                    <h1 class="font-headline fw-bold fst-italic text-dark">KINETIC</h1>
                </div>

                <!-- LOGIN FORM -->
                <div id="login-section">
                    <h2 class="font-headline fs-2 fw-bold mb-2">Welcome Back.</h2>
                    <p class="text-secondary small mb-5">Enter your credentials to access your account.</p>

                    <form id="login-form" method="post">
                        <div class="mb-4">
                            <label class="form-label font-headline small text-uppercase fw-bold text-secondary tracking-wide">Email</label>
                            <input type="email" id="login-email" class="form-control no-border-input" required placeholder="user@test.com">
                        </div>
                        <div class="mb-4">
                            <div class="d-flex justify-content-between">
                                <label class="form-label font-headline small text-uppercase fw-bold text-secondary tracking-wide">Password</label>
                                <a href="#" id="show-forgot" class="text-decoration-none text-primary small">Forgot?</a>
                            </div>
                            <input type="password" id="login-password" class="form-control no-border-input" required placeholder="••••••••">
                        </div>
                        <button type="submit" class="btn btn-kinetic-primary w-100 mt-4" style="height: 3.5rem;">Login</button>
                    </form>
                    <p class="text-center text-secondary small mt-4">
                        Don't have an account? <a href="#" id="show-register" class="text-primary text-decoration-none fw-bold">Sign up</a>
                    </p>
                </div>

                <!-- REGISTER FORM -->
                <div id="register-section" class="d-none">
                    <h2 class="font-headline fs-2 fw-bold mb-2">Join Kinetic.</h2>
                    <p class="text-secondary small mb-5">Create an account to track orders and checkout faster.</p>

                    <form id="register-form" method="post">
                        <div class="mb-4">
                            <label class="form-label font-headline small text-uppercase fw-bold text-secondary tracking-wide">Full Name</label>
                            <input type="text" id="reg-name" class="form-control no-border-input" required placeholder="John Doe">
                        </div>
                        <div class="mb-4">
                            <label class="form-label font-headline small text-uppercase fw-bold text-secondary tracking-wide">Email</label>
                            <input type="email" id="reg-email" class="form-control no-border-input" required placeholder="user@example.com">
                        </div>
                        <div class="mb-4">
                            <label class="form-label font-headline small text-uppercase fw-bold text-secondary tracking-wide">Password</label>
                            <input type="password" id="reg-password" class="form-control no-border-input" required placeholder="••••••••">
                        </div>
                        <button type="submit" class="btn btn-kinetic-primary w-100 mt-4">Create Account</button>
                    </form>
                    <p class="text-center text-secondary small mt-4">
                        Already have an account? <a href="#" id="show-login-from-reg" class="text-primary text-decoration-none fw-bold">Login</a>
                    </p>
                </div>

                <!-- FORGOT PASSWORD FORM -->
                <div id="forgot-section" class="d-none">
                    <h2 class="font-headline fs-2 fw-bold mb-2">Recover Password.</h2>
                    <p class="text-secondary small mb-5">Enter your email and we'll send you an OTP.</p>

                    <form id="forgot-form">
                        <div class="mb-4">
                            <label class="form-label font-headline small text-uppercase fw-bold text-secondary tracking-wide">Email</label>
                            <input type="email" id="forgot-email" class="form-control no-border-input" required placeholder="user@example.com">
                        </div>
                        <div id="otp-group" class="mb-4 d-none">
                            <label class="form-label font-headline small text-uppercase fw-bold text-secondary tracking-wide">OTP Code</label>
                            <input type="text" id="forgot-otp" class="form-control no-border-input" placeholder="123456">
                        </div>
                        <button type="button" id="btn-send-otp" class="btn btn-kinetic-secondary w-100 mt-2">Send OTP</button>
                        <button type="submit" id="btn-verify-otp" class="btn btn-kinetic-primary w-100 mt-4 d-none">Verify & Login</button>
                    </form>
                    <p class="text-center text-secondary small mt-4">
                        <a href="#" id="show-login-from-forgot" class="text-primary text-decoration-none fw-bold">Back to Login</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const sLogin = document.getElementById('login-section');
        const sReg = document.getElementById('register-section');
        const sForgot = document.getElementById('forgot-section');

        document.getElementById('show-register').addEventListener('click', (e) => { e.preventDefault(); sLogin.classList.add('d-none'); sReg.classList.remove('d-none'); });
        document.getElementById('show-login-from-reg').addEventListener('click', (e) => { e.preventDefault(); sReg.classList.add('d-none'); sLogin.classList.remove('d-none'); });
        document.getElementById('show-forgot').addEventListener('click', (e) => { e.preventDefault(); sLogin.classList.add('d-none'); sForgot.classList.remove('d-none'); });
        document.getElementById('show-login-from-forgot').addEventListener('click', (e) => { e.preventDefault(); sForgot.classList.add('d-none'); sLogin.classList.remove('d-none'); });
    });
</script>
}
