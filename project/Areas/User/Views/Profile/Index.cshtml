                            <span class="d-block small text-secondary">Qty: 1</span>
                        </div>
                    </div>
                </div>
                <div class="mt-4 pt-3 text-end">
                    <button class="btn btn-sm btn-outline-dark rounded-pill px-4">View Invoice</button>
                </div>
            </div>

            <!-- Order 2 -->
            <div class="bg-surface-lowest p-4 rounded-3 mb-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom border-light">
                    <div>
                        <span class="d-block small text-secondary">Order ORD-67890</span>
                        <span class="d-block fw-bold">2024-01-20</span>
                    </div>
                    <div class="text-end">
