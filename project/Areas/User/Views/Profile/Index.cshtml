                        <span class="d-block small text-secondary">Order ORD-12345</span>
                        <span class="d-block fw-bold">2024-01-15</span>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-success rounded-pill px-3 py-2 lh-1">Completed</span>
                        <span class="d-block fw-bold fs-5 mt-1">$180.00</span>
                    </div>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-3 mt-3">
                        <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuC-Z59r9b0vyyQJzgaLYRB6Ib8kMRiAg7yPUznIdRxusg0xsX3Rnp4GY5IUj5WL-qBAt1Y8IifoRj7RGC_94TQXfsJsI-fIX-QMZOBJHfZR_Nj42kcwWcV2ULKSN28dpD3twGVToH35WexsqQ8enob5avvYPYmoHt-Ckrg0wWg29eThLjkD1BqM9fFWPUpl-LoRJ2poo0pS4jPOB3QrGpNGpvYzE97PJowc1YAV4Wo0ntO-fF2U43RQQ2jUYPQCACoZy9T-EGNGPjWU" style="width: 40px; mix-blend-mode: multiply;" class="rounded bg-light">
