@{
    ViewData["Title"] = "Profile & Orders";
    ViewData["ActiveNav"] = "Profile";
}

<div class="container py-5" style="max-width: 1000px;">
    <h1 class="font-headline fs-2 fw-bold mb-5">Your Profile</h1>

    <div class="row g-5">
        <!-- Sidebar Profile -->
        <div class="col-12 col-md-4">
            <div class="bg-surface-lowest p-4 rounded-3 text-center mb-4">
                <div class="position-relative d-inline-block mb-3">
                    <img src="https://ui-avatars.com/api/?name=User&background=a83900&color=fff&size=120" class="rounded-circle img-thumbnail border-0 shadow-sm" style="width:120px; height:120px; object-fit:cover;">
                    <div class="position-absolute bottom-0 end-0 bg-white rounded-circle shadow-sm p-2 d-flex align-items-center justify-content-center" style="width:36px; height:36px;">
                        <span class="material-symbols-outlined text-primary fs-6">cloud_upload</span>
                    </div>
                </div>
                <h3 class="font-headline fs-5 fw-bold mb-1">John Doe</h3>
                <p class="text-secondary small mb-0">user@test.com</p>
                <button class="btn btn-sm btn-outline-secondary rounded-pill mt-3 px-4">Edit Profile</button>
            </div>
            
            <div class="list-group list-group-flush bg-surface-lowest rounded-3 overflow-hidden">
                <a href="#" class="list-group-item list-group-item-action py-3 fw-bold bg-light">Order History</a>
                <a href="#" class="list-group-item list-group-item-action py-3">Addresses</a>
                <a href="#" class="list-group-item list-group-item-action py-3">Payment Methods</a>
            </div>
        </div>

        <!-- Orders List -->
        <div class="col-12 col-md-8">
            <h2 class="font-headline fs-4 fw-bold mb-4">Order History</h2>
            
            <!-- Order 1 -->
