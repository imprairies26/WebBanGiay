@model project.Models.User
@{
    ViewData["Title"] = Localizer["ProfileTitle"];
    ViewData["ActiveNav"] = "Profile";
    var orders = ViewBag.Orders as List<project.Models.Order> ?? new List<project.Models.Order>();
    var activeTab = ViewBag.ActiveTab as string ?? "orders";
}

<div class="container py-5 mt-5" style="max-width: 1200px;">
    
    @* @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 rounded-4 mb-4">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 rounded-4 mb-4">@TempData["ErrorMessage"]</div>
    } *@

    <div class="row g-5">
        <!-- Sidebar Profile -->
        <div class="col-12 col-md-4">
            <div class="glass-card p-4 rounded-4 text-center mb-4 border border-white shadow-sm">
                <div class="position-relative d-inline-block mb-3">
                    <img src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(Model.FullName) : Model.AvatarUrl)" 
                         class="rounded-circle img-thumbnail border-0 shadow-sm" 
                         style="width:140px; height:140px; object-fit:cover;">
                    <button class="position-absolute bottom-0 end-0 btn btn-white rounded-circle shadow-sm p-2 d-flex align-items-center justify-content-center border" 
                            style="width:40px; height:40px; background-color: #fff; border-color: gray" data-bs-toggle="modal" data-bs-target="#avatarModal">
                        <i class="fa-solid fa-camera text-primary fs-6"></i>
                    </button>
                </div>
                <h3 class="font-headline fs-4 fw-bold mb-1">@Model.FullName</h3>
                <p class="text-secondary small mb-3">@Model.Email</p>
                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 font-headline small tracking-widest text-uppercase">@Model.Role?.Name</span>
            </div>
            
            <div class="list-group list-group-flush glass-card rounded-4 overflow-hidden border border-white shadow-sm">
                <a asp-action="Index" asp-route-tab="orders" class="list-group-item list-group-item-action py-3 d-flex align-items-center gap-3 @(activeTab == "orders" ? "active bg-primary border-primary text-white" : "")">
                    <i class="fa-solid fa-bag-shopping"></i>
                    <span class="fw-bold">@Localizer["OrderHistory"]</span>
                </a>
                <a asp-action="Index" asp-route-tab="settings" class="list-group-item list-group-item-action py-3 d-flex align-items-center gap-3 @(activeTab == "settings" ? "active bg-primary border-primary text-white" : "")">
                    <i class="fa-solid fa-gear"></i>
                    <span class="fw-bold">@Localizer["AccountSettings"]</span>
                </a>
                <a asp-action="Index" asp-route-tab="security" class="list-group-item list-group-item-action py-3 d-flex align-items-center gap-3 @(activeTab == "security" ? "active bg-primary border-primary text-white" : "")">
                    <i class="fa-solid fa-lock"></i>
                    <span class="fw-bold">@Localizer["Security"]</span>
                </a>
                <a asp-area="" asp-controller="Account" asp-action="Logout" class="list-group-item list-group-item-action py-3 d-flex align-items-center gap-3 text-danger">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span class="fw-bold">@Localizer["Logout"]</span>
                </a>
            </div>
        </div>

        <!-- Content Area -->
        <div class="col-12 col-md-8">
            @if (activeTab == "orders")
            {
                <h2 class="font-headline fs-3 fw-bold mb-4">@Localizer["OrderHistory"]</h2>
                
                @if (!orders.Any())
                {
                    <div class="bg-surface-lowest p-5 rounded-4 text-center border">
                        <i class="fa-solid fa-clipboard-check fa-2xl text-secondary opacity-25 mb-4"></i>
                        <p class="text-secondary">@Localizer["NoOrders"]</p>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-kinetic-primary mt-3">@Localizer["ShopNow"]</a>
                    </div>
                }

                @foreach (var order in orders)
                {
                    <div class="glass-card p-4 rounded-4 mb-4 shadow-sm border border-white">
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                            <div>
                                <span class="d-block small text-secondary">@Localizer["OrderNo"]@order.Id</span>
                                <span class="d-block fw-bold">@order.OrderDate.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="text-end">
                                <span class="badge @OrderConstants.GetBadgeClass(order.OrderStatus) rounded-pill px-3 py-2">
                                    @Localizer["Status" + order.OrderStatus[0] + order.OrderStatus.Substring(1).ToLower()]
                                </span>
                                <span class="d-block fw-bold fs-5 mt-1 text-primary">@order.FinalAmount.ToString("N0")đ</span>
                            </div>
                        </div>
                        
                        <div class="order-items">
                            @foreach (var detail in order.OrderDetails)
                            {
                                var img = detail.ProductVariant.Product.ProductImages.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? "https://via.placeholder.com/50";
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <img src="@img" style="width: 50px; height: 50px; object-fit: cover; " class="rounded bg-light">
                                    <div class="flex-grow-1">
                                        <span class="d-block small fw-bold">@detail.ProductName</span>
                                        <span class="d-block small text-secondary">@Localizer["Size"]: @detail.Size | @Localizer["Color"]: @detail.Color | @Localizer["Qty"]: @detail.Quantity</span>
                                    </div>
                                </div>
                            }
                        </div>
                        
                        <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                            <small class="text-secondary">@Localizer["Payment"] @order.PaymentMethod</small>
                            <a asp-action="OrderDetail" asp-route-id="@order.Id" class="btn btn-sm btn-outline-dark rounded-pill px-4">@Localizer["InvoiceDetails"]</a>
                        </div>
                    </div>
                }
            }
            else if (activeTab == "settings")
            {
                <h2 class="font-headline fs-3 fw-bold mb-4">@Localizer["AccountSettings"]</h2>
                <div class="glass-card p-4 p-md-5 rounded-4 border border-white shadow-sm">
                    <form asp-action="UpdateInfo" method="post">
                        <div class="row g-4">
                            <div class="col-12">
                                <label class="form-label small text-uppercase tracking-wider fw-bold text-secondary">@Localizer["FullName"]</label>
                                <input type="text" name="fullName" value="@Model.FullName" class="form-control bg-light border-1 py-3 px-4 rounded-3 shadow-none" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-uppercase tracking-wider fw-bold text-secondary">@Localizer["EmailCannotChange"]</label>
                                <input type="email" value="@Model.Email" class="form-control bg-light border-1 py-3 px-4 rounded-3 shadow-none" readonly>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-uppercase tracking-wider fw-bold text-secondary">@Localizer["PhoneNumber"]</label>
                                <input type="tel" name="phoneNumber" value="@Model.PhoneNumber" class="form-control bg-light border-1 py-3 px-4 rounded-3 shadow-none">
                            </div>
                            <div class="col-12 mt-5">
                                <button type="submit" class="btn btn-kinetic-primary px-5 py-3">@Localizer["SaveChanges"]</button>
                            </div>
                        </div>
                    </form>
                </div>
            }
            else if (activeTab == "security")
            {
                <h2 class="font-headline fs-3 fw-bold mb-4">@Localizer["SecurityPassword"]</h2>
                <div class="glass-card p-4 p-md-5 rounded-4 border border-white shadow-sm">
                    <form asp-action="ChangePassword" method="post">
                        <div class="row g-4">
                            <div class="col-12">
                                <label class="form-label small text-uppercase tracking-wider fw-bold text-secondary">@Localizer["CurrentPassword"]</label>
                                <input type="password" name="currentPassword" class="form-control bg-light border-1 py-3 px-4 rounded-3 shadow-none" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-uppercase tracking-wider fw-bold text-secondary">@Localizer["NewPassword"]</label>
                                <input type="password" name="newPassword" class="form-control bg-light border-1 py-3 px-4 rounded-3 shadow-none" required minlength="6">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-uppercase tracking-wider fw-bold text-secondary">@Localizer["ConfirmNewPassword"]</label>
                                <input type="password" class="form-control bg-light border-1 py-3 px-4 rounded-3 shadow-none" required>
                            </div>
                            <div class="col-12 mt-5">
                                <button type="submit" class="btn btn-dark px-5 py-3 rounded-pill">@Localizer["ChangePasswordBtn"]</button>
                            </div>
                        </div>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

<!-- Avatar Modal -->
<div class="modal fade" id="avatarModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="modal-title font-headline fw-bold">@Localizer["UpdateAvatar"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UpdateAvatar" method="post">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small text-uppercase tracking-wider fw-bold text-secondary">@Localizer["ImageLink"]</label>
                        <input type="text" name="avatarUrl" class="form-control bg-light border-1 py-2 px-3 rounded-3 shadow-none" placeholder="@Localizer["ImageLinkPlaceholder"]" value="@Model.AvatarUrl">
                        <small class="text-secondary mt-2 d-block">@Localizer["ImageLinkNote"]</small>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-primary bg-primary border-0 rounded-pill px-4">@Localizer["Update"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
