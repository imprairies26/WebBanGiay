                            <span class="d-block small fw-bold">Kinetic Shift V2</span>
                            <span class="d-block small text-secondary">Qty: 2</span>
                        </div>
                    </div>
                </div>
                <div class="mt-4 pt-3 text-end">
                    <button class="btn btn-sm btn-outline-dark rounded-pill px-4">View Invoice</button>
                </div>
            </div>
        </div>
    </div>
</div>
