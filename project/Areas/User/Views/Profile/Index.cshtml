@model project.Models.User
@{
    ViewData["Title"] = "Trang cá nhân";
    ViewData["ActiveNav"] = "Profile";
    var orders = ViewBag.Orders as List<project.Models.Order> ?? new List<project.Models.Order>();
    var activeTab = ViewBag.ActiveTab as string ?? "orders";
}

<div class="container py-5 mt-5" style="max-width: 1200px;">
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 rounded-4 mb-4">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 rounded-4 mb-4">@TempData["ErrorMessage"]</div>
    }

    <div class="row g-5">
        <!-- Sidebar Profile -->
        <div class="col-12 col-md-4">
            <div class="glass-card p-4 rounded-4 text-center mb-4 border border-white shadow-sm">
                <div class="position-relative d-inline-block mb-3">
                    <img src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(Model.FullName) : Model.AvatarUrl)" 
                         class="rounded-circle img-thumbnail border-0 shadow-sm" 
                         style="width:140px; height:140px; object-fit:cover;">
                    <button class="position-absolute bottom-0 end-0 btn btn-white rounded-circle shadow-sm p-2 d-flex align-items-center justify-content-center border" 
                            style="width:40px; height:40px;" data-bs-toggle="modal" data-bs-target="#avatarModal">
                        <span class="material-symbols-outlined text-primary fs-5">photo_camera</span>
                    </button>
                </div>
                <h3 class="font-headline fs-4 fw-bold mb-1">@Model.FullName</h3>
                <p class="text-secondary small mb-3">@Model.Email</p>
                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 font-headline small tracking-widest text-uppercase">@Model.Role?.Name</span>
            </div>
            
            <div class="list-group list-group-flush glass-card rounded-4 overflow-hidden border border-white shadow-sm">
                <a asp-action="Index" asp-route-tab="orders" class="list-group-item list-group-item-action py-3 d-flex align-items-center gap-3 @(activeTab == "orders" ? "active bg-primary border-primary text-white" : "")">
                    <span class="material-symbols-outlined">shopping_bag</span>
                    <span class="fw-bold">Lịch sử đơn hàng</span>
                </a>
                <a asp-action="Index" asp-route-tab="settings" class="list-group-item list-group-item-action py-3 d-flex align-items-center gap-3 @(activeTab == "settings" ? "active bg-primary border-primary text-white" : "")">
                    <span class="material-symbols-outlined">settings</span>
                    <span class="fw-bold">Cài đặt tài khoản</span>
                </a>
                <a asp-action="Index" asp-route-tab="security" class="list-group-item list-group-item-action py-3 d-flex align-items-center gap-3 @(activeTab == "security" ? "active bg-primary border-primary text-white" : "")">
                    <span class="material-symbols-outlined">lock</span>
                    <span class="fw-bold">Bảo mật</span>
                </a>
                <a asp-area="" asp-controller="Account" asp-action="Logout" class="list-group-item list-group-item-action py-3 d-flex align-items-center gap-3 text-danger">
                    <span class="material-symbols-outlined">logout</span>
                    <span class="fw-bold">Đăng xuất</span>
                </a>
            </div>
        </div>

        <!-- Content Area -->
        <div class="col-12 col-md-8">
            @if (activeTab == "orders")
            {
                <h2 class="font-headline fs-3 fw-bold mb-4">Lịch sử đơn hàng</h2>
                
                @if (!orders.Any())
                {
                    <div class="bg-surface-lowest p-5 rounded-4 text-center border">
                        <span class="material-symbols-outlined display-1 text-secondary opacity-25 mb-3">order_approve</span>
                        <p class="text-secondary">Bạn chưa có đơn hàng nào.</p>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-kinetic-primary mt-3">Mua sắm ngay</a>
                    </div>
                }

                @foreach (var order in orders)
                {
                    <div class="glass-card p-4 rounded-4 mb-4 shadow-sm border border-white">
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                            <div>
                                <span class="d-block small text-secondary">Mã đơn #@order.Id</span>
                                <span class="d-block fw-bold">@order.OrderDate.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="text-end">
                                <span class="badge @(order.OrderStatus switch {
                                    "PENDING" => "bg-warning text-dark",
                                    "COMPLETED" => "bg-success text-white",
                                    "CANCELLED" => "bg-danger text-white",
                                    _ => "bg-secondary text-white"
                                }) rounded-pill px-3 py-2">@order.OrderStatus</span>
                                <span class="d-block fw-bold fs-5 mt-1 text-primary">@order.FinalAmount.ToString("N0")đ</span>
                            </div>
                        </div>
                        
                        <div class="order-items">
                            @foreach (var detail in order.OrderDetails)
                            {
                                var img = detail.ProductVariant.Product.ProductImages.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? "https://via.placeholder.com/50";
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <img src="@img" style="width: 50px; height: 50px; object-fit: cover; mix-blend-mode: multiply;" class="rounded bg-light">
                                    <div class="flex-grow-1">
                                        <span class="d-block small fw-bold">@detail.ProductName</span>
                                        <span class="d-block small text-secondary">Size: @detail.Size | Color: @detail.Color | SL: @detail.Quantity</span>
                                    </div>
                                </div>
                            }
                        </div>
                        
                        <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                            <small class="text-secondary">Thanh toán: @order.PaymentMethod</small>
                            <button class="btn btn-sm btn-outline-dark rounded-pill px-4">Chi tiết hóa đơn</button>
                        </div>
                    </div>
                }
            }
            else if (activeTab == "settings")
            {
                <h2 class="font-headline fs-3 fw-bold mb-4">Cài đặt tài khoản</h2>
                <div class="glass-card p-4 p-md-5 rounded-4 border border-white shadow-sm">
                    <form asp-action="UpdateInfo" method="post">
                        <div class="row g-4">
                            <div class="col-12">
                                <label class="form-label small text-uppercase tracking-wider fw-bold text-secondary">Họ và tên</label>
                                <input type="text" name="fullName" value="@Model.FullName" class="form-control bg-light border-0 py-3 px-4 rounded-3 shadow-none" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-uppercase tracking-wider fw-bold text-secondary">Email (Không thể thay đổi)</label>
                                <input type="email" value="@Model.Email" class="form-control bg-light border-0 py-3 px-4 rounded-3 shadow-none" readonly>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-uppercase tracking-wider fw-bold text-secondary">Số điện thoại</label>
                                <input type="tel" name="phoneNumber" value="@Model.PhoneNumber" class="form-control bg-light border-0 py-3 px-4 rounded-3 shadow-none">
                            </div>
                            <div class="col-12 mt-5">
                                <button type="submit" class="btn btn-kinetic-primary px-5 py-3">LƯU THAY ĐỔI</button>
                            </div>
                        </div>
                    </form>
                </div>
            }
            else if (activeTab == "security")
            {
                <h2 class="font-headline fs-3 fw-bold mb-4">Bảo mật & Mật khẩu</h2>
                <div class="glass-card p-4 p-md-5 rounded-4 border border-white shadow-sm">
                    <form asp-action="ChangePassword" method="post">
                        <div class="row g-4">
                            <div class="col-12">
                                <label class="form-label small text-uppercase tracking-wider fw-bold text-secondary">Mật khẩu hiện tại</label>
                                <input type="password" name="currentPassword" class="form-control bg-light border-0 py-3 px-4 rounded-3 shadow-none" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-uppercase tracking-wider fw-bold text-secondary">Mật khẩu mới</label>
                                <input type="password" name="newPassword" class="form-control bg-light border-0 py-3 px-4 rounded-3 shadow-none" required minlength="6">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-uppercase tracking-wider fw-bold text-secondary">Xác nhận mật khẩu mới</label>
                                <input type="password" class="form-control bg-light border-0 py-3 px-4 rounded-3 shadow-none" required>
                            </div>
                            <div class="col-12 mt-5">
                                <button type="submit" class="btn btn-dark px-5 py-3 rounded-pill">ĐỔI MẬT KHẨU</button>
                            </div>
                        </div>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

<!-- Avatar Modal -->
<div class="modal fade" id="avatarModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="modal-title font-headline fw-bold">Cập nhật ảnh đại diện</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UpdateAvatar" method="post">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small text-uppercase tracking-wider fw-bold text-secondary">Link ảnh (URL)</label>
                        <input type="text" name="avatarUrl" class="form-control bg-light border-0 py-2 px-3 rounded-3 shadow-none" placeholder="Dán link ảnh từ Cloud hoặc mạng xã hội..." value="@Model.AvatarUrl">
                        <small class="text-secondary mt-2 d-block">Lưu ý: Hiện tại hệ thống hỗ trợ cập nhật qua đường dẫn URL công khai.</small>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary bg-primary border-0 rounded-pill px-4">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>
