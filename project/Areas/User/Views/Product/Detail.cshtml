@model project.Models.Product
@{
    ViewData["Title"] = Model.Name + " - KINETIC";
    var mainImage = Model.ProductImages.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? Model.ProductImages.FirstOrDefault()?.ImageUrl ?? "https://via.placeholder.com/600x600";
    var subImages = Model.ProductImages.Where(i => i.ImageUrl != mainImage).ToList();
}

<div class="container-fluid max-width-1440 py-5 px-4 mt-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-5">
        <ol class="breadcrumb small text-uppercase tracking-wider">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-secondary text-decoration-none">Cửa hàng</a></li>
            <li class="breadcrumb-item text-secondary"><a href="#" class="text-secondary text-decoration-none">@Model.Category.Name</a></li>
            <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row g-5">
        <!-- Gallery -->
        <div class="col-lg-7">
            <div class="product-gallery position-sticky" style="top: 120px;">
                <div class="main-image-container bg-surface-low rounded-4 mb-3 overflow-hidden d-flex align-items-center justify-content-center p-5" style="aspect-ratio: 1/1;">
                    <img id="main-image" src="@mainImage" alt="@Model.Name" class="img-fluid" style="filter: drop-shadow(0 30px 50px rgba(0,0,0,0.15));">
                </div>
                
                @if (subImages.Any())
                {
                    <div class="row g-3">
                        <div class="col-3">
                            <div class="thumbnail-item rounded-3 border active-thumb cursor-pointer overflow-hidden p-2 bg-light" onclick="changeImage('@mainImage', this)">
                                <img src="@mainImage" class="img-fluid">
                            </div>
                        </div>
                        @foreach (var img in subImages)
                        {
                            <div class="col-3">
                                <div class="thumbnail-item rounded-3 border cursor-pointer overflow-hidden p-2 bg-light" onclick="changeImage('@img.ImageUrl', this)">
                                    <img src="@img.ImageUrl" class="img-fluid">
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Info -->
        <div class="col-lg-5">
            <div class="product-info-card p-2">
                <div class="mb-4">
                    <span class="badge bg-dark text-white rounded-pill px-3 py-2 mb-3 text-uppercase small tracking-widest" style="font-family: 'Space Mono';">@Model.Category.Name</span>
                    <h1 class="display-5 fw-bold font-headline mb-2">@Model.Name</h1>
                    <div class="d-flex align-items-center gap-3">
                        @if (Model.SalePrice.HasValue && Model.SalePrice < Model.BasePrice)
                        {
                            <span class="fs-2 fw-bold text-primary">@Model.SalePrice.Value.ToString("N0")đ</span>
                            <span class="fs-4 text-secondary text-decoration-line-through">@Model.BasePrice.ToString("N0")đ</span>
                            <span class="badge bg-danger rounded-pill">-@(Math.Round((1 - Model.SalePrice.Value / Model.BasePrice) * 100))%</span>
                        }
                        else
                        {
                            <span class="fs-2 fw-bold text-primary">@Model.BasePrice.ToString("N0")đ</span>
                        }
                    </div>
                </div>

                <p class="text-secondary mb-5 pb-4 border-bottom" style="line-height: 1.8;">
                    @Model.Description
                </p>

                <form id="add-to-cart-form" asp-area="User" asp-controller="Cart" asp-action="Add" method="post">
                    <!-- Color Selection -->
                    <div class="mb-5">
                        <label class="form-label small fw-bold text-secondary text-uppercase tracking-wider">Màu sắc</label>       
                        <div class="d-flex gap-3 mt-2">
                            @{
                                var colors = Model.ProductVariants.Select(v => v.Color).Distinct().ToList();
                                bool firstColor = true;
                            }
                            @foreach (var color in colors)
                            {
                                <div class="color-option">
                                    <input type="radio" class="btn-check" name="color" id="c-@color" value="@color" @(firstColor ? "checked" : "") onchange="updateVariants()">
                                    <label class="btn btn-outline-light border rounded-pill px-4 py-2 text-dark small fw-bold" for="c-@color">@color</label>
                                </div>
                                firstColor = false;
                            }
                        </div>
                    </div>

                    <!-- Size Selection -->
                    <div class="mb-5">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <label class="form-label small fw-bold text-secondary text-uppercase tracking-wider">Kích thước</label>
                            <a href="#" class="text-decoration-underline small text-dark">Bảng size</a>
                        </div>
                        <div id="sizes-container" class="row g-2">
                            <div class="col-12 text-secondary small italic">Vui lòng chọn màu sắc để xem kích thước còn hàng.</div>
                        </div>
                    </div>

                    <div class="mb-5">
                        <button type="submit" id="btn-submit" class="btn btn-kinetic-primary w-100 py-4 fs-5 fw-bold shadow-lg" disabled>
                            THÊM VÀO GIỎ HÀNG
                        </button>
                    </div>
                </form>

                <!-- Features -->
                <div class="row g-4 mt-2">
                    <div class="col-6">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-light rounded-circle p-3">
                                <i class="fa-solid fa-truck-fast text-dark"></i>
                            </div>
                            <div>
                                <span class="d-block small fw-bold">Giao hàng miễn phí</span>
                                <small class="text-secondary">Cho đơn hàng trên 2tr</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-light rounded-circle p-3">
                                <i class="fa-solid fa-rotate-left text-dark"></i>
                            </div>
                            <div>
                                <span class="d-block small fw-bold">30 ngày đổi trả</span>
                                <small class="text-secondary">Dễ dàng và nhanh chóng</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const variants = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProductVariants.Select(v => new { v.Id, v.Color, v.Size, v.StockQuantity })));

        function changeImage(url, thumb) {
            document.getElementById('main-image').src = url;
            document.querySelectorAll('.thumbnail-item').forEach(el => el.classList.remove('active-thumb'));
            thumb.classList.add('active-thumb');
        }

        function updateVariants() {
            const selectedColor = document.querySelector('input[name="color"]:checked').value;
            const sizesContainer = document.getElementById('sizes-container');
            const submitBtn = document.getElementById('btn-submit');
            
            const availableSizes = variants.filter(v => v.Color === selectedColor);
            
            sizesContainer.innerHTML = ''; // Clear existing
            availableSizes.forEach(v => {
                const col = document.createElement('div');
                col.className = 'col-3 col-md-2';
                
                const input = document.createElement('input');
                input.type = 'radio';
                input.className = 'btn-check';
                input.name = 'variantId';
                input.id = `v-${v.Id}`;
                input.value = v.Id;
                if (v.StockQuantity === 0) input.disabled = true;
                input.onchange = enableSubmit;
                
                const label = document.createElement('label');
                label.className = `btn btn-outline-secondary w-100 py-3 fw-bold ${v.StockQuantity === 0 ? 'opacity-25' : ''}`;
                label.setAttribute('for', `v-${v.Id}`);
                label.textContent = v.Size;
                
                if (v.StockQuantity > 0 && v.StockQuantity < 5) {
                    const small = document.createElement('small');
                    small.className = 'd-block text-danger';
                    small.style.fontSize = '0.5rem';
                    small.textContent = `Chỉ còn ${v.StockQuantity}`;
                    label.appendChild(small);
                }
                
                col.appendChild(input);
                col.appendChild(label);
                sizesContainer.appendChild(col);
            });

            submitBtn.disabled = true;
            submitBtn.innerText = "CHỌN KÍCH THƯỚC";
        }

        function enableSubmit() {
            const submitBtn = document.getElementById('btn-submit');
            submitBtn.disabled = false;
            submitBtn.innerText = "THÊM VÀO GIỎ HÀNG";
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', updateVariants);
    </script>
}
