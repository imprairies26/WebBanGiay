
@{
    ViewData["Title"] = Localizer["PosTitle"];
    Layout = "~/Views/Shared/_POSLayout.cshtml";
}

<div class="container-fluid flex-grow-1 overflow-hidden p-0 d-flex flex-column flex-lg-row">
    <!-- Cột trái: Tìm kiếm & Danh sách sản phẩm -->
    <div class="col-12 col-lg-8 bg-surface-low p-4 d-flex flex-column h-100 overflow-auto">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="input-group bg-white rounded-pill px-3 py-1 shadow-sm border" style="max-width: 500px;">
                <span class="input-group-text bg-transparent border-0 text-secondary"><i class="fa-solid fa-magnifying-glass fs-6"></i></span>
                <input type="text" id="product-search" class="form-control bg-transparent border-0 shadow-none py-2" placeholder="@Localizer["SearchPlaceholder"]">
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-white rounded-pill shadow-sm px-4 border">@Localizer["All"]</button>
                <button class="btn btn-white rounded-pill shadow-sm px-4 border">@Localizer["NewArrival"]</button>
            </div>
        </div>

        <div id="search-results" class="row g-4 overflow-auto">
            <!-- Dữ liệu sản phẩm sẽ render ở đây -->
            <div class="col-12 text-center py-5 text-secondary opacity-50">
                <i class="fa-solid fa-barcode display-1"></i>
                <p class="mt-2 fs-5">@Localizer["ReadyToScan"]</p>
            </div>
        </div>
    </div>

    <!-- Cột phải: Giỏ hàng & Thanh toán -->
    <div class="col-12 col-lg-4 bg-white border-start border-secondary-subtle d-flex flex-column h-100 shadow-lg">
        <div class="p-4 border-bottom d-flex justify-content-between align-items-center bg-light">
            <h3 class="font-headline fs-5 mb-0 d-flex align-items-center gap-2">
                <i class="fa-solid fa-cart-shopping text-primary"></i>
                @Localizer["CurrentOrder"]
            </h3>
            <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="clearCart()">@Localizer["ClearAll"]</button>
        </div>

        <div id="pos-cart-items" class="flex-grow-1 overflow-auto p-4">
            <!-- Cart items render here -->
        </div>

        <div class="p-4 bg-light border-top mt-auto">
            <div class="d-flex justify-content-between mb-2">
                <span class="text-secondary">@Localizer["Subtotal"]</span>
                <span id="pos-subtotal" class="fw-bold">0đ</span>
            </div>
            <div class="d-flex justify-content-between mb-4">
                <span class="text-secondary">@Localizer["Discount"]</span>
                <span id="pos-discount" class="text-danger fw-bold">0đ</span>
            </div>
            <hr class="my-4">
            <div class="d-flex justify-content-between mb-5 font-headline fs-4 fw-bold">
                <span>@Localizer["Total"]</span>
                <span id="pos-total" class="text-primary">0đ</span>
            </div>

            <button class="btn btn-kinetic-primary w-100 py-3 fs-5 fw-bold shadow" onclick="checkout()">@Localizer["PayAndPrint"]</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let cart = [];
        let allProducts = [];
        const searchInput = document.getElementById('product-search');
        const resultsContainer = document.getElementById('search-results');
        const cartContainer = document.getElementById('pos-cart-items');

        // Load all products on start
        async function loadAllProducts() {
            try {
                const res = await fetch('/POS/Sale/GetAllProducts');
                allProducts = await res.json();
                renderSearchResults(allProducts);
            } catch (e) {
                console.error("Failed to load products", e);
            }
        }

        searchInput.addEventListener('input', (e) => {
            const query = e.target.value.toLowerCase();
            if (!query) {
                renderSearchResults(allProducts);
                return;
            }

            const filtered = allProducts.filter(p => 
                p.name.toLowerCase().includes(query) || 
                p.sku.toLowerCase().includes(query)
            );
            renderSearchResults(filtered);
        });

        function renderSearchResults(products) {
            resultsContainer.innerHTML = '';
            if (products.length === 0) {
                const empty = document.createElement('div');
                empty.className = 'col-12 text-center py-5 text-secondary';
                empty.textContent = '@Localizer["NoProductsFound"]';
                resultsContainer.appendChild(empty);
                return;
            }

            products.forEach(p => {
                const col = document.createElement('div');
                col.className = 'col-6 col-md-4 col-xl-3 mb-4';
                
                const card = document.createElement('div');
                card.className = 'glass-card p-3 rounded-4 border border-white shadow-sm hover-lift cursor-pointer h-100 d-flex flex-column';
                card.onclick = () => addToCart(p.id, p.name, p.price, p.image, p.size, p.color);
                
                const img = document.createElement('img');
                img.src = p.image || '/Data/blank_avatar.webp';
                img.className = 'img-fluid mb-3 rounded-3 bg-white p-2';
                img.style.aspectRatio = '1/1';
                img.style.objectFit = 'contain';
                
                const title = document.createElement('h4');
                title.className = 'small fw-bold mb-1 text-truncate';
                title.textContent = p.name;

                const variant = document.createElement('div');
                variant.className = 'small text-secondary mb-2';
                variant.textContent = `${p.size} | ${p.color}`;
                
                const price = document.createElement('p');
                price.className = 'text-primary fw-bold mt-auto mb-0';
                price.textContent = `${p.price.toLocaleString()}đ`;
                
                card.appendChild(img);
                card.appendChild(title);
                card.appendChild(variant);
                card.appendChild(price);
                col.appendChild(card);
                resultsContainer.appendChild(col);
            });
        }

        function addToCart(id, name, price, image, size, color) {
            const existing = cart.find(item => item.id === id);
            if (existing) {
                existing.quantity++;
            } else {
                cart.push({ id, name, price, image, size, color, quantity: 1 });
            }
            updateCartUI();
        }

        function removeFromCart(id) {
            cart = cart.filter(item => item.id !== id);
            updateCartUI();
        }

        function updateQuantity(id, delta) {
            const item = cart.find(i => i.id === id);
            if (item) {
                item.quantity += delta;
                if (item.quantity <= 0) removeFromCart(id);
            }
            updateCartUI();
        }

        function clearCart() {
            cart = [];
            updateCartUI();
        }

        function updateCartUI() {
            cartContainer.innerHTML = '';
            if (cart.length === 0) {
                const empty = document.createElement('div');
                empty.className = 'text-center py-5 text-secondary opacity-50';
                empty.innerHTML = '<p>@Localizer["EmptyCart"]</p>';
                cartContainer.appendChild(empty);
                document.getElementById('pos-subtotal').innerText = '0đ';
                document.getElementById('pos-total').innerText = '0đ';
                return;
            }

            cart.forEach(item => {
                const row = document.createElement('div');
                row.className = 'd-flex align-items-center gap-3 mb-4 pb-3 border-bottom border-light';
                
                const img = document.createElement('img');
                img.src = item.image || '/Data/blank_avatar.webp';
                img.className = 'rounded bg-light p-1';
                img.style.width = '50px';
                img.style.height = '50px';
                img.style.objectFit = 'contain';
                
                const info = document.createElement('div');
                info.className = 'flex-grow-1 min-width-0';
                
                const name = document.createElement('div');
                name.className = 'small fw-bold text-truncate';
                name.textContent = item.name;

                const variant = document.createElement('div');
                variant.className = 'text-secondary';
                variant.style.fontSize = '0.7rem';
                variant.textContent = `${item.size} / ${item.color}`;
                
                const actions = document.createElement('div');
                actions.className = 'd-flex align-items-center gap-3 mt-1';
                
                const qtyWrap = document.createElement('div');
                qtyWrap.className = 'd-flex align-items-center gap-2';
                
                const btnMinus = document.createElement('button');
                btnMinus.className = 'btn btn-sm p-0 border-0 bg-transparent';
                btnMinus.innerHTML = '<i class="fa-solid fa-circle-minus text-secondary opacity-50"></i>';
                btnMinus.onclick = () => updateQuantity(item.id, -1);
                
                const qty = document.createElement('span');
                qty.className = 'small fw-bold px-1';
                qty.textContent = item.quantity;
                
                const btnPlus = document.createElement('button');
                btnPlus.className = 'btn btn-sm p-0 border-0 bg-transparent';
                btnPlus.innerHTML = '<i class="fa-solid fa-circle-plus text-primary"></i>';
                btnPlus.onclick = () => updateQuantity(item.id, 1);
                
                const itemTotal = document.createElement('span');
                itemTotal.className = 'small text-primary fw-bold';
                itemTotal.textContent = `${(item.price * item.quantity).toLocaleString()}đ`;
                
                qtyWrap.appendChild(btnMinus);
                qtyWrap.appendChild(qty);
                qtyWrap.appendChild(btnPlus);
                actions.appendChild(qtyWrap);
                actions.appendChild(itemTotal);
                info.appendChild(name);
                info.appendChild(variant);
                info.appendChild(actions);
                
                const btnRemove = document.createElement('button');
                btnRemove.className = 'btn btn-sm text-danger p-0 border-0 bg-transparent';
                btnRemove.innerHTML = '<i class="fa-solid fa-trash-can small"></i>';
                btnRemove.onclick = () => removeFromCart(item.id);
                
                row.appendChild(img);
                row.appendChild(info);
                row.appendChild(btnRemove);
                cartContainer.appendChild(row);
            });

            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            document.getElementById('pos-subtotal').innerText = subtotal.toLocaleString() + 'đ';
            document.getElementById('pos-total').innerText = subtotal.toLocaleString() + 'đ';
        }

        async function checkout() {
            if (cart.length === 0) {
                alert('@Localizer["PleaseSelectProduct"]');
                return;
            }

            const totalAmount = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            
            const requestData = {
                items: cart.map(i => ({ variantId: i.id, quantity: i.quantity, unitPrice: i.price })),
                totalAmount: totalAmount,
                discountAmount: 0,
                finalAmount: totalAmount,
                paymentMethod: 'Cash'
            };

            try {
                const res = await fetch('/POS/Sale/PlaceOrder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(requestData)
                });
                const data = await res.json();

                if (data.success) {
                    alert('@Localizer["CheckoutSuccess"]' + ' ID: #' + data.orderId);
                    clearCart();
                    loadAllProducts(); // Refresh stock
                } else {
                    alert('Lỗi: ' + data.message);
                }
            } catch (e) {
                alert('Có lỗi xảy ra khi thanh toán.');
                console.error(e);
            }
        }

        // Initialize
        loadAllProducts();
    </script>
}
