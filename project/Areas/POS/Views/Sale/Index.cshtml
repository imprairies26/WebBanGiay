
@{
    ViewData["Title"] = Localizer["PosTitle"];
    Layout = "~/Views/Shared/_POSLayout.cshtml";
}

<div class="container-fluid flex-grow-1 overflow-hidden p-0 d-flex flex-column flex-lg-row">
    <!-- Cột trái: Tìm kiếm & Danh sách sản phẩm -->
    <div class="col-12 col-lg-8 bg-surface-low p-4 d-flex flex-column h-100 overflow-auto">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="input-group bg-white rounded-pill px-3 py-1 shadow-sm border" style="max-width: 500px;">
                <span class="input-group-text bg-transparent border-0 text-secondary"><i class="fa-solid fa-magnifying-glass fs-6"></i></span>
                <input type="text" id="product-search" class="form-control bg-transparent border-0 shadow-none py-2" placeholder="@Localizer["SearchPlaceholder"]">
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-white rounded-pill shadow-sm px-4 border">@Localizer["All"]</button>
                <button class="btn btn-white rounded-pill shadow-sm px-4 border">@Localizer["NewArrival"]</button>
            </div>
        </div>

        <div id="search-results" class="row g-4 overflow-auto">
            <!-- Dữ liệu sản phẩm sẽ render ở đây -->
            <div class="col-12 text-center py-5 text-secondary opacity-50">
                <i class="fa-solid fa-barcode display-1"></i>
                <p class="mt-2 fs-5">@Localizer["ReadyToScan"]</p>
            </div>
        </div>
    </div>

    <!-- Cột phải: Giỏ hàng & Thanh toán -->
    <div class="col-12 col-lg-4 bg-white border-start border-secondary-subtle d-flex flex-column h-100 shadow-lg">
        <div class="p-4 border-bottom d-flex justify-content-between align-items-center bg-light">
            <h3 class="font-headline fs-5 mb-0 d-flex align-items-center gap-2">
                <i class="fa-solid fa-cart-shopping text-primary"></i>
                @Localizer["CurrentOrder"]
            </h3>
            <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="clearCart()">@Localizer["ClearAll"]</button>
        </div>

        <div id="pos-cart-items" class="flex-grow-1 overflow-auto p-4">
            <!-- Cart items render here -->
        </div>

        <div class="p-4 bg-light border-top mt-auto">
            <div class="d-flex justify-content-between mb-2">
                <span class="text-secondary">@Localizer["Subtotal"]</span>
                <span id="pos-subtotal" class="fw-bold">0đ</span>
            </div>
            <div class="d-flex justify-content-between mb-4">
                <span class="text-secondary">@Localizer["Discount"]</span>
                <span id="pos-discount" class="text-danger fw-bold">0đ</span>
            </div>
            <hr class="my-4">
            <div class="d-flex justify-content-between mb-5 font-headline fs-4 fw-bold">
                <span>@Localizer["Total"]</span>
                <span id="pos-total" class="text-primary">0đ</span>
            </div>

            <button class="btn btn-kinetic-primary w-100 py-3 fs-5 fw-bold shadow" onclick="checkout()">@Localizer["PayAndPrint"]</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let cart = [];
        const searchInput = document.getElementById('product-search');
        const resultsContainer = document.getElementById('search-results');
        const cartContainer = document.getElementById('pos-cart-items');

        searchInput.addEventListener('input', (e) => {
            const query = e.target.value;
            if (query.length < 2) return;

            fetch(`/POS/Sale/SearchProducts?query=${query}`)
                .then(res => res.json())
                .then(products => {
                    renderSearchResults(products);
                });
        });

        function renderSearchResults(products) {
            if (products.length === 0) {
                resultsContainer.innerHTML = '<div class="col-12 text-center py-5 text-secondary">@Localizer["NoProductsFound"]</div>';
                return;
            }

            resultsContainer.innerHTML = products.map(p => `
                <div class="col-6 col-md-4 col-xl-3">
                    <div class="glass-card p-3 rounded-4 border border-white shadow-sm hover-lift cursor-pointer h-100" onclick="addToCart('${p.id}', '${p.name}', ${p.price}, '${p.image}')">
                        <img src="${p.image}" class="img-fluid mb-3 rounded-3 bg-white p-2" style="aspect-ratio:1/1; object-fit:contain; ">
                        <h4 class="small fw-bold mb-1 text-truncate">${p.name}</h4>
                        <p class="text-primary fw-bold mb-0">${p.price.toLocaleString()}đ</p>
                    </div>
                </div>
            `).join('');
        }

        function addToCart(id, name, price, image) {
            const existing = cart.find(item => item.id === id);
            if (existing) {
                existing.quantity++;
            } else {
                cart.push({ id, name, price, image, quantity: 1 });
            }
            updateCartUI();
        }

        function removeFromCart(id) {
            cart = cart.filter(item => item.id !== id);
            updateCartUI();
        }

        function updateQuantity(id, delta) {
            const item = cart.find(i => i.id === id);
            if (item) {
                item.quantity += delta;
                if (item.quantity <= 0) removeFromCart(id);
            }
            updateCartUI();
        }

        function clearCart() {
            cart = [];
            updateCartUI();
        }

        function updateCartUI() {
            if (cart.length === 0) {
                cartContainer.innerHTML = '<div class="text-center py-5 text-secondary opacity-50"><p>@Localizer["EmptyCart"]</p></div>';
                document.getElementById('pos-subtotal').innerText = '0đ';
                document.getElementById('pos-total').innerText = '0đ';
                return;
            }

            cartContainer.innerHTML = cart.map(item => `
                <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom border-light">
                    <img src="${item.image}" class="rounded bg-light p-1" style="width:50px; height:50px; object-fit:contain; ">
                    <div class="flex-grow-1 min-width-0">
                        <div class="small fw-bold text-truncate">${item.name}</div>
                        <div class="d-flex align-items-center gap-3 mt-2">
                            <div class="d-flex align-items-center gap-2">
                                <button class="btn btn-sm p-0 btn-minus" onclick="updateQuantity('${item.id}', -1)"><i class="fa-solid fa-minus fs-6"></i></button>
                                <span class="small fw-bold px-1">${item.quantity}</span>
                                <button class="btn btn-sm p-0 btn-plus" onclick="updateQuantity('${item.id}', 1)"><i class="fa-solid fa-plus fs-6"></i></button>
                            </div>
                            <span class="small text-primary fw-bold">${(item.price * item.quantity).toLocaleString()}đ</span>
                        </div>
                    </div>
                    <button class="btn btn-sm text-danger p-0 btn-remove" onclick="removeFromCart('${item.id}')"><i class="fa-solid fa-xmark fs-5"></i></button>
                </div>
            `).join('');

            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            document.getElementById('pos-subtotal').innerText = subtotal.toLocaleString() + 'đ';
            document.getElementById('pos-total').innerText = subtotal.toLocaleString() + 'đ';
        }

        function checkout() {
            if (cart.length === 0) {
                alert('@Localizer["PleaseSelectProduct"]');
                return;
            }
            alert('@Localizer["CheckoutSuccess"]');
            clearCart();
        }

        // Initialize empty state
        updateCartUI();
    </script>
}
