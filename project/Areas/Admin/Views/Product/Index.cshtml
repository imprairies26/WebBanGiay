@model List<project.Models.Product>
@{
    ViewData["Title"] = Localizer["ProductManagementTitle"];
    ViewData["ActiveNav"] = "Products";
    var categories = ViewBag.Categories as List<project.Models.Category> ?? new List<project.Models.Category>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="font-headline fs-3 fw-bold mb-0">@Localizer["ProductManagementTitle"]</h1>
    <a asp-action="Create" class="btn btn-dark rounded-pill px-4">@Localizer["AddProduct"]</a>
</div>

<!-- SEARCH & FILTER BAR -->
<div class="bg-white rounded-4 shadow-sm border border-secondary-subtle p-3 mb-4">
    <form method="get" asp-action="Index">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-5">
                <div class="input-group bg-light rounded-pill px-3 py-1 border-0">
                    <span class="input-group-text bg-transparent border-0 text-secondary"><i class="fa-solid fa-magnifying-glass fs-6"></i></span>
                    <input type="text" name="search" value="@Context.Request.Query["search"]" class="form-control bg-transparent border-0 shadow-none small" placeholder="@Localizer["SearchPlaceholder"]">
                </div>
            </div>
            <div class="col-12 col-md-3">
                <select name="categoryId" class="form-select bg-light border-0 rounded-pill px-4 shadow-none small">
                    <option value="">@Localizer["AllCategories"]</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id" selected="@(Context.Request.Query["categoryId"] == cat.Id.ToString())">@cat.Name</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary bg-primary border-0 rounded-pill flex-grow-1 fw-bold small">@Localizer["Filter"]</button>
                <a asp-action="Index" class="btn btn-light border rounded-pill px-4 small">@Localizer["Reset"]</a>
            </div>
        </div>
    </form>
</div>

<div class="bg-white rounded-4 shadow-sm border border-secondary-subtle p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 text-nowrap">
            <thead class="bg-surface-low text-secondary font-headline small text-uppercase">
                <tr>
                    <th class="py-3 px-4">@Localizer["Product"]</th>
                    <th class="py-3">@Localizer["Category"]</th>
                    <th class="py-3 text-center">@Localizer["Stock"]</th>
                    <th class="py-3">@Localizer["Price"]</th>
                    <th class="py-3">@Localizer["Status"]</th>
                    <th class="py-3 text-end px-4">@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var mainImage = item.ProductImages.FirstOrDefault(i => i.IsMain)?.ImageUrl 
                                   ?? item.ProductImages.FirstOrDefault()?.ImageUrl 
                                   ?? "https://via.placeholder.com/50x50";
                    var totalStock = item.ProductVariants.Sum(v => v.StockQuantity);

                    <tr class="@(!item.IsActive ? "opacity-50" : "")">
                        <td class="px-4">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@mainImage" class="img-thumbnail border-0 bg-light p-1" style="width: 50px; height: 50px; object-fit: cover;" loading="lazy">
                                <div>
                                    <span class="fw-bold d-block">@item.Name</span>
                                    <small class="text-secondary">#@item.Id</small>
                                </div>
                            </div>
                        </td>
                        <td>@item.Category.Name</td>
                        <td class="text-center">
                            <span class="fw-bold @(totalStock == 0 ? "text-danger" : "text-dark")">@totalStock</span>
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@item.BasePrice.ToString("N0")đ</div>
                            @if (item.SalePrice.HasValue)
                            {
                                <small class="text-danger">@Localizer["Sale"]: @item.SalePrice.Value.ToString("N0")đ</small>
                            }
                        </td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">@Localizer["Active"]</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">@Localizer["Inactive"]</span>
                            }
                            
                            @if (item.IsFeatured)
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill">@Localizer["Featured"]</span>
                            }
                        </td>
                        <td class="text-end px-4">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark rounded-pill px-3">@Localizer["Edit"]</a>
                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill ms-2 btn-delete" 
                                    data-id="@item.Id" data-name="@item.Name">@Localizer["Delete"]</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-body p-4 text-center">
                <i class="fa-solid fa-triangle-exclamation text-danger display-4 mb-3"></i>
                <h4 class="fw-bold mb-2">@Localizer["ConfirmDelete"]</h4>
                <p class="text-secondary mb-4">@Localizer["DeletePrompt"] <span id="delete-item-name" class="text-dark fw-bold"></span>?</p>
                <form id="delete-form" method="post" asp-action="Delete">
                    <input type="hidden" name="id" id="delete-item-id" />
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-light flex-grow-1 rounded-pill" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                        <button type="submit" class="btn btn-danger flex-grow-1 rounded-pill">@Localizer["ConfirmDelete"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            const deleteItemName = document.getElementById('delete-item-name');
            const deleteItemId = document.getElementById('delete-item-id');

            document.querySelectorAll('.btn-delete').forEach(btn => {
                btn.addEventListener('click', function() {
                    const id = this.getAttribute('data-id');
                    const name = this.getAttribute('data-name');
                    
                    deleteItemId.value = id;
                    deleteItemName.textContent = name;
                    deleteModal.show();
                });
            });
        });
    </script>
}
