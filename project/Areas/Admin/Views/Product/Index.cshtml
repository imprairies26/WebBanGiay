@model IEnumerable<project.Models.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
    ViewData["ActiveNav"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="font-headline fs-3 fw-bold mb-0 text-uppercase">QUẢN LÝ SẢN PHẨM</h1>
    @* Thay đổi từ Modal sang trang Create riêng để xử lý Upload ảnh tốt hơn *@
    <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="btn btn-dark rounded-pill px-4">+ Thêm sản phẩm</a>
</div>

<form asp-action="Index" method="get">
    <div class="bg-white rounded-4 shadow-sm border border-secondary-subtle p-3 mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-5">
                <div class="input-group bg-light rounded-pill px-3 py-1 border-0">
                    <span class="input-group-text bg-transparent border-0 text-secondary">
                        <span class="material-symbols-outlined fs-5">search</span>
                    </span>
                    @* Name="searchString" để khớp với tham số trong Controller *@
                    <input type="text" name="searchString" class="form-control bg-transparent border-0 shadow-none small"
                           placeholder="Tìm tên sản phẩm..." value="@Context.Request.Query["searchString"]">
                </div>
            </div>
            <div class="col-12 col-md-3">
                @* Đổ danh mục động từ ViewBag *@
                <select name="categoryId" asp-items="ViewBag.CategoryList" class="form-select bg-light border-0 rounded-pill px-4 shadow-none small">
                    <option value="">Tất cả danh mục</option>
                </select>
            </div>
            <div class="col-12 col-md-2">
                @* Bạn có thể thêm lọc trạng thái nếu cần, hiện tại tôi để mặc định *@
                <select class="form-select bg-light border-0 rounded-pill px-4 shadow-none small">
                    <option selected>Trạng thái</option>
                    <option>Đang bán</option>
                    <option>Hết hàng</option>
                </select>
            </div>
            <div class="col-12 col-md-2">
                <button type="submit" class="btn btn-primary bg-primary border-0 rounded-pill w-100 fw-bold small">LỌC</button>
            </div>
        </div>
    </div>
</form>

<div class="bg-white rounded-4 shadow-sm border border-secondary-subtle p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 text-nowrap">
            <thead class="bg-surface-low text-secondary font-headline small text-uppercase">
                <tr>
                    <th class="py-3 px-4">Sản phẩm</th>
                    <th class="py-3">Danh mục</th>
                    <th class="py-3">Giá gốc</th>
                    <th class="py-3">Tags</th>
                    <th class="py-3 text-end px-4">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="px-4">
                                <div class="d-flex align-items-center gap-3">
                                    @* Lấy ảnh đầu tiên trong danh sách ảnh *@
                                    @{
                                        var firstImage = item.ProductImages?.FirstOrDefault()?.ImageUrl ?? "/images/default-product.png";
                                    }
                                    <img src="@firstImage" class="img-thumbnail border-0 bg-light p-1" style="width: 50px; height: 50px; object-fit: contain; mix-blend-mode: multiply;">
                                    <span class="fw-bold">@item.Name</span>
                                </div>
                            </td>
                            <td>@(item.Category?.Name ?? "N/A")</td>
                            <td class="fw-bold text-primary">@item.BasePrice.ToString("C")</td>
                            <td>
                                @if (item.IsFeatured)
                                {
                                    <span class="badge bg-secondary me-1">Featured</span>
                                }
                                @if (item.SalePrice.HasValue)
                                {
                                    <span class="badge bg-danger me-1">Sale</span>
                                }
                            </td>
                            <td class="text-end px-4">
                                <a asp-area="Admin" asp-controller="Product" asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-dark rounded-pill px-3">Sửa</a>
                                <a asp-area="Admin" asp-controller="Product" asp-action="Delete" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger rounded-pill ms-2">Xóa</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-secondary">Không tìm thấy sản phẩm nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>