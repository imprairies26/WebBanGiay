@model project.Areas.Admin.Models.ProductVM

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="font-headline fs-3 fw-bold mb-0 text-uppercase">Thêm sản phẩm mới</h1>
        <a asp-action="Index" class="btn btn-outline-dark rounded-pill px-4">Quay lại</a>
    </div>

    <div class="bg-white rounded-4 shadow-sm border border-secondary-subtle p-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div class="row g-4">
                <div class="col-md-8">
                    <label asp-for="Product.Name" class="form-label small text-secondary fw-bold text-uppercase">Tên sản phẩm</label>
                    <input asp-for="Product.Name" class="form-control bg-light border-0 rounded-3 p-3" placeholder="Nhập tên sản phẩm...">
                        <span asp-validation-for="Product.Name" class="text-danger"></span>

                        <div class="mt-4">
                            <label asp-for="Product.Description" class="form-label small text-secondary fw-bold text-uppercase">Mô tả chi tiết</label>
                            <textarea asp-for="Product.Description" rows="5" class="form-control bg-light border-0 rounded-3"></textarea>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-4 border border-secondary-subtle">
                            <div class="mb-3">
                                <label asp-for="Product.CategoryId" class="form-label small text-secondary fw-bold text-uppercase">Danh mục</label>
                                <select asp-for="Product.CategoryId" asp-items="@Model.CategoryList" class="form-select border-0 shadow-none">
                                    <option disabled selected>-- Chọn danh mục --</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Product.BasePrice" class="form-label small text-secondary fw-bold text-uppercase">Giá gốc ($)</label>
                                <input asp-for="Product.BasePrice" class="form-control border-0" type="number" step="0.01">
                                </div>
                                <div class="mb-3">
                                    <div class="form-check form-switch">
                                        <input asp-for="Product.IsFeatured" class="form-check-input" type="checkbox">
                                            <label class="form-check-label fw-bold small text-uppercase">Sản phẩm nổi bật</label>
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold py-2 mt-3">LƯU SẢN PHẨM</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>