@model project.Models.Product

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-body p-5 text-center">
                    <div class="text-danger mb-4">
                        <span class="material-symbols-outlined style-icon" style="font-size: 80px;">warning</span>
                    </div>
                    <h2 class="fw-bold mb-3">Xác nhận xóa?</h2>
                    <p class="text-secondary mb-4">Bạn có chắc chắn muốn xóa sản phẩm <strong>"@Model.Name"</strong>? Hành động này không thể hoàn tác.</p>
                    
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-3 justify-content-center">
                            <a asp-action="Index" class="btn btn-light rounded-pill px-5">Hủy bỏ</a>
                            <button type="submit" class="btn btn-danger rounded-pill px-5">Xóa ngay</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>