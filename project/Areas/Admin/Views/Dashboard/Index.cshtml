@model project.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = Localizer["Dashboard"] + " - KINETIC Admin";
    ViewData["ActiveNav"] = "Dashboard";
}

<div class="mb-5">
    <h1 class="font-headline fs-3 fw-bold mb-1">@Localizer["DashboardTitle"]</h1>
    <p class="text-secondary small">@Localizer["DashboardDesc"]</p>
</div>

<!-- Stats Cards -->
<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="glass-card p-4 rounded-4 border border-white shadow-sm h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="bg-primary-subtle p-2 rounded-3">
                    <i class="fa-solid fa-dollar-sign text-primary fs-5"></i>
                </div>
                <span class="text-success small fw-bold"><i class="fa-solid fa-arrow-trend-up pe-1"></i>+12%</span>
            </div>
            <span class="text-secondary small fw-bold text-uppercase tracking-wider">@Localizer["Revenue"]</span>
            <h2 class="fw-bold fs-3 mt-2 mb-0">@Model.TotalRevenue.ToString("N0")đ</h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card p-4 rounded-4 border border-white shadow-sm h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="bg-dark p-2 rounded-3">
                    <i class="fa-solid fa-box text-white fs-5"></i>
                </div>
                <span class="text-success small fw-bold"><i class="fa-solid fa-arrow-trend-up pe-1"></i>+5%</span>
            </div>
            <span class="text-secondary small fw-bold text-uppercase tracking-wider">@Localizer["NewOrders"]</span>
            <h2 class="fw-bold fs-3 mt-2 mb-0">@Model.TotalOrders</h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card p-4 rounded-4 border border-white shadow-sm h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="bg-info-subtle p-2 rounded-3">
                    <i class="fa-solid fa-users text-info fs-5"></i>
                </div>
            </div>
            <span class="text-secondary small fw-bold text-uppercase tracking-wider">@Localizer["Customers"]</span>
            <h2 class="fw-bold fs-3 mt-2 mb-0">@Model.TotalCustomers</h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="glass-card p-4 rounded-4 border border-white shadow-sm h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="bg-warning-subtle p-2 rounded-3">
                    <i class="fa-solid fa-warehouse text-warning fs-5"></i>
                </div>
            </div>
            <span class="text-secondary small fw-bold text-uppercase tracking-wider">@Localizer["Products"]</span>
            <h2 class="fw-bold fs-3 mt-2 mb-0">@Model.TotalProducts</h2>
        </div>
    </div>
</div>

<div class="row g-5">
    <div class="col-lg-7">
        <div class="glass-card p-4 p-md-5 rounded-4 border border-white shadow-sm bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-5">
                <h3 class="font-headline fs-5 mb-0">@Localizer["OrderDistribution"]</h3>
                <div class="dropdown">
                    <button class="btn btn-sm btn-light border rounded-pill px-3" type="button">@Localizer["Last7Days"]</button>
                </div>
            </div>
            <div style="height: 350px;">
                <canvas id="orderChart"></canvas>
            </div>
        </div>
    </div>
...
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('orderChart').getContext('2d');
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Online Orders', 'POS Orders'],
                datasets: [{
                    data: [@Model.OnlineOrders, @Model.PosOrders],
                    backgroundColor: ['#2563eb', '#1e293b'],
                    borderWidth: 0,
                    hoverOffset: 10
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            usePointStyle: true,
                            padding: 20,
                            font: {
                                family: 'Be Vietnam Pro',
                                size: 12
                            }
                        }
                    }
                },
                cutout: '70%'
            }
        });
    </script>
}
    <div class="col-lg-4">
        <div class="glass-card p-4 rounded-4 border border-white shadow-sm h-100">
            <h3 class="font-headline fs-5 mb-4">@Localizer["RecentOrders"]</h3>
            <div class="list-group list-group-flush">
                @foreach (var order in Model.RecentOrders)
                {
                    <div class="list-group-item bg-transparent border-0 px-0 py-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-light rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="fa-solid fa-receipt text-secondary small"></i>
                            </div>
                            <div>
                                <span class="d-block small fw-bold">#@order.Id</span>
                                <small class="text-secondary">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                        </div>
                        <div class="text-end">
                            <span class="d-block small fw-bold text-primary">@order.FinalAmount.ToString("N0")đ</span>
                            <span class="badge @OrderConstants.GetBadgeClass(order.OrderStatus) rounded-pill" style="font-size: 0.6rem;">
                                @Localizer[order.OrderStatus[0] + order.OrderStatus.Substring(1).ToLower()]
                            </span>
                        </div>
                    </div>
                }
            </div>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-link text-dark text-decoration-none w-100 mt-3 small fw-bold">@Localizer["ViewAll"] <i class="fa-solid fa-chevron-right ps-1"></i></a>
        </div>
    </div>
</div>

<style>
    .border-dashed {
        border: 2px dashed rgba(0,0,0,0.05) !important;
    }
</style>
