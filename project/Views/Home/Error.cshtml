@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["ErrorTitle"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <div class="mb-5">
                <i class="fa-solid fa-triangle-exclamation text-danger opacity-25" style="font-size: 5rem;"></i>
            </div>
            <h1 class="display-4 fw-bold font-headline mb-3">@Localizer["SorryHeader"]</h1>
            <p class="text-secondary fs-5 mb-0">@Localizer["ErrorMsg"]</p>
            <div class="mt-5">
                <a asp-area="User" asp-controller="Home" asp-action="Index" class="btn btn-kinetic-primary px-5 py-3">@Localizer["BackToHomeBtn"]</a>
            </div>
        </div>
    </div>
</div>
