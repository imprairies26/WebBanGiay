@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["NotFoundTitle"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <div class="mb-5">
                <h1 class="display-1 fw-bold text-dark opacity-10" style="font-size: 10rem;">404</h1>
            </div>
            <h2 class="fw-bold font-headline mb-4">@Localizer["NotFoundHeader"]</h2>
            <p class="text-secondary fs-5 mb-5">@Localizer["NotFoundMsg"]</p>
            <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                <a asp-area="User" asp-controller="Home" asp-action="Index" class="btn btn-kinetic-primary px-5 py-3">@Localizer["BackToHomeBtn"]</a>
            </div>
        </div>
    </div>
</div>
