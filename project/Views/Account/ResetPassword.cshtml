@model project.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="container-fluid p-0">
    <div class="row min-vh-100 g-0">
        <!-- Cột Hình ảnh -->
        <div class="col-lg-7 d-none d-lg-flex bg-surface-low p-5 align-items-center justify-content-center position-relative overflow-hidden">
            <div class="position-absolute top-0 start-0 p-5">
                <a class="text-decoration-none font-headline fs-3 text-dark fw-bold tracking-tighter" href="/" style="font-family: 'Be Vietnam Pro', sans-serif; letter-spacing: -2px;">KINETIC</a>
            </div>
            
            <div class="text-center z-1">
                <h2 class="font-headline fs-1 fw-bold mb-3 text-uppercase">KHÔI PHỤC TRUY CẬP.</h2>
                <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuC-Z59r9b0vyyQJzgaLYRB6Ib8kMRiAg7yPUznIdRxusg0xsX3Rnp4GY5IUj5WL-qBAt1Y8IifoRj7RGC_94TQXfsJsI-fIX-QMZOBJHfZR_Nj42kcwWcV2ULKSN28dpD3twGVToH35WexsqQ8enob5avvYPYmoHt-Ckrg0wWg29eThLjkD1BqM9fFWPUpl-LoRJ2poo0pS4jPOB3QrGpNGpvYzE97PJowc1YAV4Wo0ntO-fF2U43RQQ2jUYPQCACoZy9T-EGNGPjWU" 
                     alt="Reset" class="img-fluid" style="max-width: 70%; filter: drop-shadow(0 30px 60px rgba(0,0,0,0.1));">
            </div>
        </div>
        
        <!-- Cột Form -->
        <div class="col-12 col-lg-5 d-flex align-items-center justify-content-center bg-white shadow-lg z-2">
            <div class="w-100 p-4 p-md-5" style="max-width: 450px;">
                <div class="mb-5">
                    <h2 class="fw-bold fs-2 mb-2">Mật khẩu mới</h2>
                    <p class="text-secondary small">Vui lòng thiết lập mật khẩu mới cho tài khoản của bạn.</p>
                </div>

                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Token" value="@ViewBag.Token" />
                    <input type="hidden" name="Email" value="@ViewBag.Email" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="NewPassword" class="form-label small fw-bold text-secondary text-uppercase tracking-wider">Mật khẩu mới</label>
                        <div class="input-group bg-light rounded-3 px-3 py-1 border-0">
                             <span class="input-group-text bg-transparent border-0 text-secondary p-0 me-2"><i class="fa-solid fa-lock fs-6"></i></span>
                             <input asp-for="NewPassword" type="password" class="form-control bg-transparent border-0 shadow-none py-2" placeholder="••••••••">
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label small fw-bold text-secondary text-uppercase tracking-wider">Xác nhận mật khẩu mới</label>
                        <div class="input-group bg-light rounded-3 px-3 py-1 border-0">
                             <span class="input-group-text bg-transparent border-0 text-secondary p-0 me-2"><i class="fa-solid fa-lock-check fs-6"></i></span>
                             <input asp-for="ConfirmPassword" type="password" class="form-control bg-transparent border-0 shadow-none py-2" placeholder="••••••••">
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <button type="submit" class="btn btn-kinetic-primary w-100 py-3 mb-4 rounded-3 fw-bold">CẬP NHẬT MẬT KHẨU</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
