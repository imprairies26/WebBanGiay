 @model project.Models.LoginViewModel

@{
    ViewData["Title"] = Localizer["LoginTitle"];
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="container-fluid p-0">
    <div class="row min-vh-100 g-0">
        <!-- Cột Hình ảnh -->
        <div class="col-lg-7 d-none d-lg-flex bg-surface-low p-5 align-items-center justify-content-center position-relative overflow-hidden">
            <div class="position-absolute top-0 start-0 p-5">
                <a class="text-decoration-none font-headline fs-3 text-dark fw-bold tracking-tighter" href="/" style="font-family: 'Be Vietnam Pro', sans-serif; letter-spacing: -2px;">KINETIC</a>
            </div>
            
            <div class="text-center z-1">
                <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuC-Z59r9b0vyyQJzgaLYRB6Ib8kMRiAg7yPUznIdRxusg0xsX3Rnp4GY5IUj5WL-qBAt1Y8IifoRj7RGC_94TQXfsJsI-fIX-QMZOBJHfZR_Nj42kcwWcV2ULKSN28dpD3twGVToH35WexsqQ8enob5avvYPYmoHt-Ckrg0wWg29eThLjkD1BqM9fFWPUpl-LoRJ2poo0pS4jPOB3QrGpNGpvYzE97PJowc1YAV4Wo0ntO-fF2U43RQQ2jUYPQCACoZy9T-EGNGPjWU" 
                     alt="Kinetic Shoe" 
                     class="img-fluid floating-img"
                     style="max-width: 80%; transform: rotate(-15deg); filter: drop-shadow(0 50px 80px rgba(0,0,0,0.2)); margin-bottom: 30px;">
                <div class="mt-5 text-uppercase">
                    <h2 class="font-headline fs-1 fw-bold mb-3">@Localizer["HeroTagline"]</h2>
                </div>
            </div>
        </div>
        
        <!-- Cột Form Đăng nhập -->
        <div class="col-12 col-lg-5 d-flex align-items-center justify-content-center bg-white shadow-lg z-2">
            <div class="w-100 p-4 p-md-5" style="max-width: 450px;">
                <div class="mb-5">
                    <h2 class="fw-bold fs-2 mb-2">@Localizer["WelcomeBack"]</h2>
                    <p class="text-secondary small">@Localizer["LoginSubtitle"]</p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success border-0 rounded-3 small mb-4">
                        @TempData["SuccessMessage"]
                    </div>
                }

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Identifier" class="form-label small fw-bold text-secondary text-uppercase tracking-wider">@Localizer["EmailOrUsername"]</label>
                        <div class="input-group bg-light rounded-3 px-3 py-1 border-0">
                             <span class="input-group-text bg-transparent border-0 text-secondary p-0 me-2"><i class="fa-solid fa-envelope fs-6"></i></span>
                             <input asp-for="Identifier" class="form-control bg-transparent border-0 shadow-none py-2" placeholder="name@example.com">
                        </div>
                        <span asp-validation-for="Identifier" class="text-danger small mt-1 d-block"></span>
                    </div>
                    
                    <div class="mb-4">
                        <div class="d-flex justify-content-between">
                            <label asp-for="Password" class="form-label small fw-bold text-secondary text-uppercase tracking-wider">@Localizer["Password"]</label>
                            <a asp-action="ForgotPassword" class="text-decoration-none text-primary small fw-bold" tabindex="-1" >@Localizer["ForgotPassword"]</a>
                        </div>
                        <div class="input-group bg-light rounded-3 px-3 py-1 border-0">
                             <span class="input-group-text bg-transparent border-0 text-secondary p-0 me-2"><i class="fa-solid fa-lock fs-6"></i></span>
                             <input asp-for="Password" class="form-control bg-transparent border-0 shadow-none py-2" placeholder="••••••••">
                        </div>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input shadow-none" type="checkbox">
                        <label asp-for="RememberMe" class="form-check-label small text-secondary">@Localizer["RememberMe"]</label>
                    </div>

                    <button type="submit" class="btn btn-kinetic-primary w-100 py-3 mb-4 rounded-3 fw-bold">@Localizer["LoginButton"]</button>
                    
                    <div class="position-relative text-center my-4">
                        <hr class="text-secondary opacity-25">
                        <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-secondary small">@Localizer["OrLoginWith"]</span>
                    </div>

                    <div class="row g-2 mb-4">
                        <div class="col-6">
                            <button type="button" class="btn btn-outline-light border text-dark w-100 py-2 small fw-bold rounded-3 d-flex align-items-center justify-content-center gap-2">
                                <i class="fa-brands fa-google"></i> Google
                            </button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="btn btn-outline-light border text-dark w-100 py-2 small fw-bold rounded-3 d-flex align-items-center justify-content-center gap-2">
                                <i class="fa-brands fa-facebook"></i> Facebook
                            </button>
                        </div>
                    </div>
                </form>

                <p class="text-center text-secondary small mt-5">
                    @Localizer["NoAccount"] <a asp-action="Register" class="text-primary text-decoration-none fw-bold">@Localizer["RegisterLink"]</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .floating-img {
        animation: floatLogin 6s ease-in-out infinite;
    }
    @@keyframes floatLogin {
        0%, 100% { transform: translateY(0) rotate(-15deg); }
        50% { transform: translateY(-20px) rotate(-12deg); }
    }
</style>
