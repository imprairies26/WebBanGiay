@model project.Models.RegisterViewModel

@{
    ViewData["Title"] = Localizer["RegisterTitle"];
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="container-fluid p-0">
    <div class="row min-vh-100 g-0">
        <!-- Cột Hình ảnh -->
        <div class="col-lg-7 d-none d-lg-flex bg-surface-low p-5 align-items-center justify-content-center position-relative overflow-hidden">
            <div class="position-absolute top-0 start-0 p-5">
                <a class="text-decoration-none font-headline fs-3 text-dark fw-bold tracking-tighter" href="/" style="font-family: 'Be Vietnam Pro', sans-serif; letter-spacing: -2px;">KINETIC</a>
            </div>
            
            <div class="text-center z-1">
                <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuCiv-dSomy1GRdVWCzkxAiqMU_QD9JQqwwwDHCouIGBSiRWk-6vRjgwvxzt8hFEOx3cIbNpNPXv1kFZxqW1XiODW6wYvrdsDOfkCxneIw_PJ18x-BULd80W0a0cbbvpOQ42l7EKYh0ZAzvK6UvFoSJdnCG69Tp1OVri3rQoFq1LHvXuG1eIv_vIkruE6CBwiRDWq8mMIaAp_I_V7QWrCuors0TMm0bI-_pUXRKiVT-35EPxIu_yEuoKPaZx5uOgYj2xbH8cjmMleohk" 
                     alt="Kinetic Shoe" 
                     class="img-fluid floating-img"
                     style="max-width: 80%; transform: rotate(10deg); filter: drop-shadow(0 50px 80px rgba(0,0,0,0.2));">
                <div class="mt-5">
                    <h2 class="font-headline fs-1 fw-bold mb-3 text-uppercase">@Localizer["HeroTaglineReg"]</h2>
                    <p class="text-secondary small tracking-widest">@Localizer["HeroSubtitle"]</p>
                </div>
            </div>
        </div>
        
        <!-- Cột Form Đăng ký -->
        <div class="col-12 col-lg-5 d-flex align-items-center justify-content-center bg-white shadow-lg z-2">
            <div class="w-100 p-4 p-md-5" style="max-width: 450px;">
                <div class="mb-5">
                    <h2 class="fw-bold fs-2 mb-2">@Localizer["WelcomeReg"]</h2>
                    <p class="text-secondary small">@Localizer["RegisterSubtitle"]</p>
                </div>

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="FullName" class="form-label small fw-bold text-secondary text-uppercase tracking-wider">@Localizer["FullName"]</label>
                        <div class="input-group bg-light rounded-3 px-3 py-1 border-0">
                             <input asp-for="FullName" class="form-control bg-transparent border-0 shadow-none py-2" placeholder="Nguyễn Văn A">
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label small fw-bold text-secondary text-uppercase tracking-wider">@Localizer["Email"]</label>
                        <div class="input-group bg-light rounded-3 px-3 py-1 border-0">
                             <input asp-for="Email" class="form-control bg-transparent border-0 shadow-none py-2" placeholder="name@example.com">
                        </div>
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>
                    
                    <div class="mb-4">
                        <label asp-for="Password" class="form-label small fw-bold text-secondary text-uppercase tracking-wider">@Localizer["Password"]</label>
                        <div class="input-group bg-light rounded-3 px-3 py-1 border-0">
                             <input asp-for="Password" class="form-control bg-transparent border-0 shadow-none py-2" placeholder="••••••••">
                        </div>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label small fw-bold text-secondary text-uppercase tracking-wider">@Localizer["ConfirmPassword"]</label>
                        <div class="input-group bg-light rounded-3 px-3 py-1 border-0">
                             <input asp-for="ConfirmPassword" class="form-control bg-transparent border-0 shadow-none py-2" placeholder="••••••••">
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-check mb-4 small text-secondary">
                        <input class="form-check-input shadow-none" type="checkbox" id="terms" required>
                        <label class="form-check-label" for="terms">@Localizer["TermsAgree"] <a href="#" class="text-primary text-decoration-none fw-bold">@Localizer["TermsLink"]</a></label>
                    </div>

                    <button type="submit" class="btn btn-kinetic-primary w-100 py-3 mb-4 rounded-3 fw-bold">@Localizer["RegisterButton"]</button>
                </form>

                <p class="text-center text-secondary small mt-5">
                    @Localizer["AlreadyAccount"] <a asp-action="Login" class="text-primary text-decoration-none fw-bold">@Localizer["LoginLink"]</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .floating-img {
        animation: floatReg 6s ease-in-out infinite;
    }
    @@keyframes floatReg {
        0%, 100% { transform: translateY(0) rotate(10deg); }
        50% { transform: translateY(-20px) rotate(15deg); }
    }
    .field-validation-error {
        font-size: 0.75rem;
        font-weight: 500;
    }
</style>
