<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - KINETIC Admin</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Epilogue:ital,wght@0,100..900;1,100..900&family=Manrope:wght@200..800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <!-- Custom Style -->
    <link href="~/css/style.css" rel="stylesheet" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-surface vh-100 overflow-hidden d-flex flex-column no-padding-top">

<!-- ADMIN HEADER -->
<header class="bg-white border-bottom border-secondary-subtle px-4 py-3 d-flex justify-content-between align-items-center shadow-sm z-3">
    <div class="d-flex align-items-center gap-4">
        <a class="text-decoration-none font-headline fs-4 fst-italic text-dark fw-bold" asp-area="User" asp-controller="Home" asp-action="Index">KINETIC <span class="badge bg-dark fs-6 fst-normal align-middle ms-2">ADMIN</span></a>
    </div>
    <div class="d-flex align-items-center gap-3">
        <span class="text-secondary small fw-bold">Admin</span>
        <a asp-area="User" asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-danger rounded-pill">Logout</a>
    </div>
</header>

<!-- MAIN LAYOUT -->
<div class="container-fluid flex-grow-1 overflow-hidden p-0 d-flex flex-column flex-lg-row">
    
    <!-- SIDEBAR -->
    <div class="col-12 col-lg-2 bg-white d-flex flex-column h-100 border-end border-secondary-subtle admin-sidebar">
        <div class="list-group list-group-flush pt-4">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="list-group-item list-group-item-action py-3 @(ViewData["ActiveNav"]?.ToString() == "Dashboard" ? "active" : "text-secondary my-1")">Dashboard</a>
            <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="list-group-item list-group-item-action py-3 @(ViewData["ActiveNav"]?.ToString() == "Products" ? "active" : "text-secondary my-1")">Products</a>
            <a asp-area="Admin" asp-controller="User" asp-action="Index" class="list-group-item list-group-item-action py-3 @(ViewData["ActiveNav"]?.ToString() == "Users" ? "active" : "text-secondary my-1")">Users / Roles</a>
        </div>
    </div>

    <!-- CONTENT -->
    <div class="col-12 col-lg-10 bg-surface-low p-4 p-md-5 overflow-auto">
        @RenderBody()
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
