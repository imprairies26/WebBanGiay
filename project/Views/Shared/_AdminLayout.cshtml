@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - KINETIC Admin</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome 6.5.1 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@100..900&family=Montserrat:wght@100..900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <!-- Custom Style -->
    <link href="~/css/style.css" rel="stylesheet" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-surface vh-100 overflow-hidden d-flex flex-column no-padding-top">

<div class="d-flex h-100">
    <!-- Sidebar -->
    <div class="admin-sidebar bg-dark text-white h-100 d-flex flex-column p-4 shadow-lg" style="width: 280px; z-index: 1050;">
        <div class="mb-5 px-2 d-flex align-items-center justify-content-between">
            <a class="text-decoration-none font-headline fs-4 fst-italic text-white fw-bold tracking-tighter" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">KINETIC</a>
            <!-- Language Selector Mini -->
            <div class="dropdown">
                <button class="btn btn-link text-white opacity-50 p-0 border-0 dropdown-toggle no-caret" type="button" data-bs-toggle="dropdown">
                    <i class="fa-solid fa-globe me-1"></i>
                    <span class="small fw-bold">@System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToUpper()</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark shadow border-0">
                    <li>
                        <form asp-area="" asp-controller="Language" asp-action="SetLanguage" method="post">
                            <input type="hidden" name="culture" value="vi-VN" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit" class="dropdown-item small d-flex align-items-center gap-2 @(System.Globalization.CultureInfo.CurrentCulture.Name == "vi-VN" ? "active" : "")">
                                <span>🇻🇳</span> Tiếng Việt
                            </button>
                        </form>
                    </li>
                    <li>
                        <form asp-area="" asp-controller="Language" asp-action="SetLanguage" method="post">
                            <input type="hidden" name="culture" value="en-US" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit" class="dropdown-item small d-flex align-items-center gap-2 @(System.Globalization.CultureInfo.CurrentCulture.Name == "en-US" ? "active" : "")">
                                <span>🇺🇸</span> English
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>

        <div class="list-group list-group-flush flex-grow-1">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" 
               class="list-group-item list-group-item-action bg-transparent text-white py-3 d-flex align-items-center gap-3 @(ViewData["ActiveNav"]?.ToString() == "Dashboard" ? "active" : "opacity-50")">
                <i class="fa-solid fa-chart-line fs-5"></i>
                <span class="fw-bold">@Localizer["Dashboard"]</span>
            </a>
            <a asp-area="Admin" asp-controller="Product" asp-action="Index" 
               class="list-group-item list-group-item-action bg-transparent text-white py-3 d-flex align-items-center gap-3 @(ViewData["ActiveNav"]?.ToString() == "Products" ? "active" : "opacity-50")">
                <i class="fa-solid fa-box fs-5"></i>
                <span class="fw-bold">@Localizer["Products"]</span>
            </a>
            <a asp-area="Admin" asp-controller="User" asp-action="Index" 
               class="list-group-item list-group-item-action bg-transparent text-white py-3 d-flex align-items-center gap-3 @(ViewData["ActiveNav"]?.ToString() == "Users" ? "active" : "opacity-50")">
                <i class="fa-solid fa-users fs-5"></i>
                <span class="fw-bold">@Localizer["Users"]</span>
            </a>
            <a asp-area="Admin" asp-controller="Order" asp-action="Index" 
               class="list-group-item list-group-item-action bg-transparent text-white py-3 d-flex align-items-center gap-3 @(ViewData["ActiveNav"]?.ToString() == "Orders" ? "active" : "opacity-50")">
                <i class="fa-solid fa-receipt fs-5"></i>
                <span class="fw-bold">@Localizer["Orders"]</span>
            </a>
            <a asp-area="Admin" asp-controller="Promotion" asp-action="Index" 
               class="list-group-item list-group-item-action bg-transparent text-white py-3 d-flex align-items-center gap-3 @(ViewData["ActiveNav"]?.ToString() == "Promotions" ? "active" : "opacity-50")">
                <i class="fa-solid fa-ticket fs-5"></i>
                <span class="fw-bold">@Localizer["Promotions"]</span>
            </a>
        </div>

        <div class="mt-auto border-top border-secondary pt-4">
            <div class="d-flex align-items-center gap-3 px-2 mb-4">
                <img src="@Context.Session.GetString("UserAvatar")" class="rounded-circle border" style="width: 40px; height: 40px; object-fit: cover;">
                <div class="overflow-hidden">
                    <span class="d-block fw-bold small text-truncate">@Context.Session.GetString("UserFullName")</span>
                    <span class="badge bg-primary rounded-pill" style="font-size: 0.5rem;">@Context.Session.GetString("UserRole")</span>
                </div>
            </div>
            <a asp-area="" asp-controller="Account" asp-action="Logout" class="btn btn-outline-light btn-sm w-100 rounded-pill py-2 fw-bold opacity-75">@Localizer["Logout"]</a>
        </div>
    </div>

    <!-- Main Content -->
    <div class="flex-grow-1 p-4 p-md-5 overflow-auto">
        @RenderBody()
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
