<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - KINETIC</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@100..900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <!-- Custom Style -->
    <link href="~/css/style.css" rel="stylesheet" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body style="font-family: 'Be Vietnam Pro', sans-serif;">

<!-- USER TOP NAV -->
<header class="fixed-top glass-nav mx-auto mt-3 px-4 py-2 d-flex justify-content-between align-items-center rounded-pill shadow-sm" style="max-width: 1400px; width: calc(100% - 2rem); left: 0; right: 0;">
    <div class="d-flex align-items-center gap-4 flex-grow-1">
        <a class="text-decoration-none font-headline fs-4 fst-italic text-dark fw-bold tracking-tighter" asp-area="User" asp-controller="Home" asp-action="Index" style="font-family: 'Be Vietnam Pro', sans-serif; letter-spacing: -2px;">KINETIC</a>
        <nav class="d-none d-lg-flex gap-4 ms-3">
            <a asp-area="User" asp-controller="Home" asp-action="Index" class="nav-kinetic-link @(ViewData["ActiveNav"]?.ToString() == "Shop" ? "active" : "")">Shop</a>
            <a asp-area="User" asp-controller="Profile" asp-action="Index" class="nav-kinetic-link @(ViewData["ActiveNav"]?.ToString() == "Profile" ? "active" : "")">Profile</a>
        </nav>
    </div>
    
    <!-- DYNAMIC SEARCH BAR -->
    <div class="search-container d-none d-md-flex align-items-center bg-light rounded-pill px-3 py-1 flex-grow-1 mx-4" style="max-width: 450px; border: 1px solid rgba(0,0,0,0.05);">
        <span class="material-symbols-outlined text-secondary fs-5">search</span>
        <input type="text" class="form-control bg-transparent border-0 shadow-none small py-1" placeholder="Tìm kiếm sản phẩm, thương hiệu..." aria-label="Search">
        <span class="text-secondary opacity-50 small d-none d-lg-block">⌘K</span>
    </div>

    <div class="d-flex align-items-center gap-2">
        <a asp-area="" asp-controller="Account" asp-action="Login" class="btn btn-link text-dark p-2 border-0 hover-lift rounded-circle d-none d-md-block">
            <span class="material-symbols-outlined fs-5">person</span>
        </a>
        <a asp-area="User" asp-controller="Cart" asp-action="Index" class="btn btn-link text-dark p-2 border-0 position-relative hover-lift rounded-circle">
            <span class="material-symbols-outlined fs-5">shopping_bag</span>
            <span id="cart-count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary border border-white" style="font-size: 0.6rem; padding: 0.25em 0.4em;"></span>
        </a>
        <!-- MOBILE MENU TOGGLE -->
        <button class="btn btn-link text-dark p-2 border-0 d-md-none">
            <span class="material-symbols-outlined fs-4">menu</span>
        </button>
    </div>
</header>

<!-- MAIN CONTENT -->
<main>
    @RenderBody()
</main>

<!-- FOOTER -->
<footer class="bg-surface-low w-100 py-5 mt-5">
    <div class="container-fluid max-width-1440 px-4">
        <div class="row g-5">
            <div class="col-12 col-lg-4">
                <a class="font-headline fs-4 fst-italic text-dark text-decoration-none fw-bold d-block mb-3" asp-area="User" asp-controller="Home" asp-action="Index">KINETIC</a>
                <p class="text-secondary small tracking-wide" style="max-width: 250px;">
                    Precision engineered footwear for those who refuse to stand still.
                </p>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="d-flex flex-column gap-3">
                    <a href="#" class="text-secondary text-decoration-none small hover-primary">Support</a>
                    <a href="#" class="text-secondary text-decoration-none small hover-primary">Contact</a>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="d-flex flex-column gap-3">
                    <a href="#" class="text-secondary text-decoration-none small hover-primary">Shipping</a>
                    <a href="#" class="text-secondary text-decoration-none small hover-primary">Returns</a>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="d-flex flex-column gap-3">
                    <a href="#" class="text-secondary text-decoration-none small hover-primary">Privacy</a>
                </div>
            </div>
        </div>
        <div class="row mt-5 pt-4 border-top border-secondary-subtle">
            <div class="col-12 text-center">
                <p class="text-secondary small tracking-wide">
                    © 2024 KINETIC PRECISION. ENGINEERED FOR MOTION.
                </p>
            </div>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
