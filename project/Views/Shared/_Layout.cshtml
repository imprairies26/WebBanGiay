@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    var userId = Context.Session.GetString("UserId");
    var userName = Context.Session.GetString("UserFullName");
    var userAvatar = Context.Session.GetString("UserAvatar");
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - KINETIC</title>
    <!-- Font Awesome 6.5.1 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@100..900&family=Montserrat:wght@100..900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <!-- Custom Style -->
    <link href="~/css/style.css" rel="stylesheet" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<!-- USER TOP NAV -->
<header class="fixed-top glass-nav mx-auto mt-3 px-4 py-2 d-flex justify-content-between align-items-center rounded-pill shadow-sm" style="max-width: 1400px; width: calc(100% - 2rem); left: 0; right: 0;">
    <div class="d-flex align-items-center gap-4 flex-grow-1">
        <a class="text-decoration-none font-headline fs-4 fst-italic text-dark fw-bold tracking-tighter" asp-area="User" asp-controller="Home" asp-action="Index" style="letter-spacing: -2px;">KINETIC</a>
        <nav class="d-none d-lg-flex gap-4 ms-3">
            <a asp-area="User" asp-controller="Home" asp-action="Index" class="nav-kinetic-link @(ViewData["ActiveNav"]?.ToString() == "Shop" ? "active" : "")">@Localizer["Shop"]</a>
        </nav>
    </div>
    
    <!-- DYNAMIC SEARCH BAR -->
    <form asp-area="User" asp-controller="Home" asp-action="Index" method="get" class="search-container d-none d-md-flex align-items-center bg-light rounded-pill px-3 py-1 flex-grow-1 mx-4" style="max-width: 450px; border: 1px solid rgba(0,0,0,0.05);">
        <i class="fa-solid fa-magnifying-glass text-secondary fs-6"></i>
        <input type="text" name="search" class="form-control bg-transparent border-0 shadow-none small py-1" placeholder="@Localizer["SearchPlaceholder"]" aria-label="Search" value="@Context.Request.Query["search"]">
    </form>

    <div class="d-flex align-items-center gap-3">
        <!-- LANGUAGE SELECTOR -->
        <div class="dropdown me-2">
            <button class="btn btn-link text-dark p-0 border-0 d-flex align-items-center gap-1 text-decoration-none dropdown-toggle no-caret" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fa-solid fa-globe fs-5"></i>
                <span class="small fw-bold text-uppercase">@(System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName)</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm rounded-3">
                <li>
                    <form asp-area="" asp-controller="Language" asp-action="SetLanguage" method="post">
                        <input type="hidden" name="culture" value="vi-VN" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <button type="submit" class="dropdown-item small py-2 d-flex align-items-center gap-2 @(System.Globalization.CultureInfo.CurrentCulture.Name == "vi-VN" ? "active bg-primary" : "")">
                            <span class="fs-6">🇻🇳</span> Tiếng Việt
                        </button>
                    </form>
                </li>
                <li>
                    <form asp-area="" asp-controller="Language" asp-action="SetLanguage" method="post">
                        <input type="hidden" name="culture" value="en-US" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <button type="submit" class="dropdown-item small py-2 d-flex align-items-center gap-2 @(System.Globalization.CultureInfo.CurrentCulture.Name == "en-US" ? "active bg-primary" : "")">
                            <span class="fs-6">🇺🇸</span> English
                        </button>
                    </form>
                </li>
            </ul>
        </div>

        <a asp-area="User" asp-controller="Cart" asp-action="Index" class="btn btn-link text-dark p-2 border-0 position-relative hover-lift rounded-circle">
            <i class="fa-solid fa-bag-shopping fs-5"></i>
            <span id="cart-count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary border border-white" style="font-size: 0.6rem; padding: 0.25em 0.4em;"></span>
        </a>

        @if (!string.IsNullOrEmpty(userId))
        {
            <a asp-area="User" asp-controller="Profile" asp-action="Index" class="user-avatar-nav d-flex align-items-center gap-2 text-decoration-none text-dark bg-white rounded-pill pe-3 ps-1 py-1 shadow-sm border">
                <img src="@(string.IsNullOrEmpty(userAvatar) ? "/Data/blank_avatar.webp" : userAvatar)" class="rounded-circle border" style="width: 32px; height: 32px; object-fit: cover;" alt="Avatar">
                <span class="small fw-bold d-none d-lg-inline">@userName</span>
            </a>
                <a asp-area="" asp-controller="Account" asp-action="Logout" class="btn btn-link text-secondary border-0 hover-lift rounded-circle shadow" title="@Localizer["Logout"]">
                    <i class="fa-solid fa-arrow-right-from-bracket fs-6" style="color: rgb(235, 71, 71);"></i>
            </a>
        }
        else
        {
            <div class="d-none d-md-flex gap-2">
                <a asp-area="" asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-dark rounded-pill px-3">@Localizer["Login"]</a>
                <a asp-area="" asp-controller="Account" asp-action="Register" class="btn btn-sm btn-dark rounded-pill px-3">@Localizer["Register"]</a>
            </div>
            <a asp-area="" asp-controller="Account" asp-action="Login" class="btn btn-link text-dark p-2 border-0 hover-lift rounded-circle d-md-none">
                <i class="fa-solid fa-user fs-5"></i>
            </a>
        }

        <!-- MOBILE MENU TOGGLE -->
        <button class="btn btn-link text-dark p-2 border-0 d-md-none">
            <i class="fa-solid fa-bars fs-4"></i>
        </button>
    </div>
</header>

<!-- MAIN CONTENT -->
<main>
    @RenderBody()
</main>

<!-- FOOTER -->
<footer class="bg-surface-low w-100 py-5 mt-5">
    <div class="container-fluid max-width-1440 px-4">
        <div class="row g-5">
            <div class="col-12 col-lg-4">
                <a class="font-headline fs-4 fst-italic text-dark text-decoration-none fw-bold d-block mb-3" asp-area="User" asp-controller="Home" asp-action="Index">KINETIC</a>
                <p class="text-secondary small tracking-wide" style="max-width: 250px;">
                    @Localizer["FooterSlogan"]
                </p>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="d-flex flex-column gap-3">
                    <a href="#" class="text-secondary text-decoration-none small hover-primary">@Localizer["Support"]</a>
                    <a href="#" class="text-secondary text-decoration-none small hover-primary">@Localizer["Contact"]</a>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="d-flex flex-column gap-3">
                    <a href="#" class="text-secondary text-decoration-none small hover-primary">@Localizer["Shipping"]</a>
                    <a href="#" class="text-secondary text-decoration-none small hover-primary">@Localizer["Returns"]</a>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-2">
                <div class="d-flex flex-column gap-3">
                    <a href="#" class="text-secondary text-decoration-none small hover-primary">@Localizer["Privacy"]</a>
                </div>
            </div>
        </div>
        <div class="row mt-5 pt-4 border-top border-secondary-subtle">
            <div class="col-12 text-center">
                <p class="text-secondary small tracking-wide">
                    @Localizer["Copyright"]
                </p>
            </div>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        fetch('/User/Cart/GetCartCount')
            .then(res => res.json())
            .then(data => {
                const countBadge = document.getElementById('cart-count');
                if (data.count > 0) {
                    countBadge.innerText = data.count;
                    countBadge.classList.remove('d-none');
                } else {
                    countBadge.classList.add('d-none');
                }
            });
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
