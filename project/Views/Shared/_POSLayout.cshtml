@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - KINETIC POS</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome 6.5.1 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@100..900&family=Montserrat:wght@100..900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <!-- Custom Style -->
    <link href="~/css/style.css" rel="stylesheet" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-surface vh-100 overflow-hidden d-flex flex-column no-padding-top">

<!-- POS TOP NAV -->
<header class="bg-dark text-white shadow-sm border-bottom border-secondary-subtle">
    <div class="container-fluid px-4 py-2 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-4">
            <a class="text-decoration-none font-headline fs-4 fst-italic text-white fw-bold tracking-tighter" asp-area="POS" asp-controller="Sale" asp-action="Index">KINETIC</a>
            <div class="vr bg-secondary opacity-50 my-2"></div>
            <span class="badge bg-primary rounded-pill px-3 py-2 font-headline small tracking-widest">POS TERMINAL</span>
            <!-- Language Selector Mini -->
            <div class="dropdown ms-2">
                <button class="btn btn-link text-white opacity-50 p-0 border-0 dropdown-toggle no-caret" type="button" data-bs-toggle="dropdown">
                    <i class="fa-solid fa-globe me-1"></i>
                    <span class="small fw-bold">@System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName.ToUpper()</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark shadow border-0">
                    <li>
                        <form asp-area="" asp-controller="Language" asp-action="SetLanguage" method="post">
                            <input type="hidden" name="culture" value="vi-VN" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit" class="dropdown-item small d-flex align-items-center gap-2 @(System.Globalization.CultureInfo.CurrentCulture.Name == "vi-VN" ? "active" : "")">
                                <span>🇻🇳</span> Tiếng Việt
                            </button>
                        </form>
                    </li>
                    <li>
                        <form asp-area="" asp-controller="Language" asp-action="SetLanguage" method="post">
                            <input type="hidden" name="culture" value="en-US" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit" class="dropdown-item small d-flex align-items-center gap-2 @(System.Globalization.CultureInfo.CurrentCulture.Name == "en-US" ? "active" : "")">
                                <span>🇺🇸</span> English
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>

        <div class="d-flex align-items-center gap-3">
            <div class="text-end d-none d-md-block">
                <span class="d-block small fw-bold">@Context.Session.GetString("UserFullName")</span>
                <small class="text-secondary opacity-75">@Context.Session.GetString("UserRole") @@ Store 01</small>
            </div>
            <div class="vr bg-secondary opacity-50 my-2"></div>
            <a asp-area="" asp-controller="Account" asp-action="Logout" class="btn btn-link text-white p-2 border-0 hover-lift rounded-circle" title="@Localizer["Logout"]">
                <i class="fa-solid fa-right-from-bracket fs-5"></i>
            </a>
        </div>
    </div>
</header>

<!-- POS MAIN CONTENT -->
@RenderBody()

<script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
